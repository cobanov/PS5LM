+void llama_kv_cache::init_kq_mask_dev() {
+    kq_mask_dev = false;
+
+    const char * env = getenv("LLAMA_KQ_MASK_HOST");
+    if ((env && atoi(env) != 0) || hparams.no_alloc || layers.empty()) {
+        return;
+    }
+
+    for (const auto & layer : layers) {
+        for (const ggml_tensor * t : { layer.k, layer.v }) {
+            if (!t) {
+                continue;
+            }
+            if (!t->buffer || ggml_backend_buffer_is_host(t->buffer)) {
+                return;
+            }
+        }
+    }
+
+    kq_mask_dev = true;
+
+    LLAMA_LOG_INFO("%s: KQ mask built on the device for causal batches\n", __func__);
+}
+
+bool llama_kv_cache::can_build_kq_mask_dev(const llama_ubatch & ubatch, bool causal_attn, int64_t n_stream_cur) const {
+    if (!kq_mask_dev || !causal_attn || hparams.use_alibi || swa_type != LLAMA_SWA_TYPE_NONE || ubatch.is_pos_2d()) {
+        return false;
+    }
+
+    if (n_stream_cur <= 0 || ubatch.n_tokens == 0 || ubatch.n_tokens % n_stream_cur != 0) {
+        return false;
+    }
+
+    // the device mask has one row of cell positions per stream, so every token of a stream
+    // has to be masked against the same sequence
+    const uint32_t n_tps = ubatch.n_tokens/n_stream_cur;
+    for (int64_t s = 0; s < n_stream_cur; ++s) {
+        const llama_seq_id seq_id = ubatch.seq_id[s*n_tps][0];
+        for (uint32_t ii = 1; ii < n_tps; ++ii) {
+            if (ubatch.seq_id[s*n_tps + ii][0] != seq_id) {
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
+
+void llama_kv_cache::set_input_kq_pos(ggml_tensor * dst_kv, ggml_tensor * dst_tok, const llama_ubatch * ubatch) const {
+    GGML_ASSERT(ggml_backend_buffer_is_host(dst_kv->buffer));
+    GGML_ASSERT(ggml_backend_buffer_is_host(dst_tok->buffer));
+    GGML_ASSERT(dst_kv->type == GGML_TYPE_F32 && dst_tok->type == GGML_TYPE_F32);
+
+    const int64_t n_kv       = dst_kv->ne[0];
+    const int64_t n_tps      = dst_tok->ne[1];
+    const int64_t n_stream_c = dst_kv->ne[3];
+
+    GGML_ASSERT(dst_tok->ne[3] == n_stream_c);
+    GGML_ASSERT(n_tps*n_stream_c == (int64_t) ubatch->n_tokens);
+
+    float * kv  = (float *) dst_kv->data;
+    float * tok = (float *) dst_tok->data;
+
+    // a kept cell gives tok + kv = p1 - p0 + 1 >= 1, a future or foreign cell gives <= 0;
+    // the graph clamps that to [0, 1] and takes the log, which yields exactly 0 or -inf
+    for (int64_t s = 0; s < n_stream_c; ++s) {
+        const llama_seq_id seq_id = ubatch->seq_id[s*n_tps][0];
+
+        const auto & cells = v_cells.at(seq_to_stream[seq_id]);
+
+        for (int64_t j = 0; j < n_kv; ++j) {
+            const bool keep = !cells.is_empty(j) && cells.seq_has(j, seq_id);
+
+            kv[s*n_kv + j] = keep ? -(float) cells.pos_get(j) : -1e30f;
+        }
+
+        for (int64_t ii = 0; ii < n_tps; ++ii) {
+            tok[s*n_tps + ii] = (float) ubatch->pos[s*n_tps + ii] + 1.0f;
+        }
+    }
+}
