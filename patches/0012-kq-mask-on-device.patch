+// PS5LM: build the causal KQ mask on the device of the KV cache. Only the cell positions
+// [n_kv, 1, 1, n_stream] and the token positions [1, n_tps, 1, n_stream] are uploaded, instead
+// of the full [n_kv, n_tps, 1, n_stream] mask (21 MB per 512-token ubatch at 21k context).
+// returns nullptr when the ubatch needs the host mask
+static ggml_tensor * build_attn_inp_kq_mask_dev(
+        ggml_context * ctx,
+        const llama_kv_cache_context * mctx,
+        const llama_ubatch & ubatch,
+        const llama_cparams & cparams,
+        ggml_tensor ** pos_kv,
+        ggml_tensor ** pos_tok) {
+    const auto n_kv     = mctx->get_n_kv();
+    const auto n_tokens = ubatch.n_tokens;
+    const auto n_stream = cparams.kv_unified ? 1 : ubatch.n_seqs_unq;
+
+    if (!mctx->can_build_kq_mask_dev(ubatch, cparams.causal_attn, n_stream)) {
+        return nullptr;
+    }
+
+    const int64_t n_tps = n_tokens/n_stream;
+
+    *pos_kv = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, n_kv, 1, 1, n_stream);
+    ggml_set_input(*pos_kv);
+    ggml_set_name(*pos_kv, "attn_inp_kq_pos_kv");
+
+    *pos_tok = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 1, n_tps, 1, n_stream);
+    ggml_set_input(*pos_tok);
+    ggml_set_name(*pos_tok, "attn_inp_kq_pos_tok");
+
+    // p1 - p0 + 1 (or about -1e30 for empty and foreign cells), clamped to {0, 1}, log -> {-inf, 0}
+    ggml_tensor * res = ggml_repeat_4d(ctx, *pos_kv, n_kv, n_tps, 1, n_stream);
+    res = ggml_add_inplace(ctx, res, *pos_tok);
+    res = ggml_clamp(ctx, res, 0.0f, 1.0f);
+    res = ggml_log_inplace(ctx, res);
+
+    if (cparams.flash_attn) {
+        res = ggml_cast(ctx, res, GGML_TYPE_F16);
+    }
+    ggml_set_name(res, "attn_kq_mask_dev");
+
+    return res;
+}
+
+static bool can_reuse_kq_mask_dev(
+        ggml_tensor * pos_kv,
+        ggml_tensor * pos_tok,
+        const llama_kv_cache_context * mctx,
+        const llama_ubatch & ubatch,
+        const llama_cparams & cparams) {
+    const auto n_kv     = mctx->get_n_kv();
+    const auto n_tokens = ubatch.n_tokens;
+    const auto n_stream = cparams.kv_unified ? 1 : ubatch.n_seqs_unq;
+
+    if (!mctx->can_build_kq_mask_dev(ubatch, cparams.causal_attn, n_stream)) {
+        return false;
+    }
+
+    bool res = true;
+
+    res &= (pos_kv->ne[0]  == n_kv);
+    res &= (pos_kv->ne[3]  == n_stream);
+    res &= (pos_tok->ne[1] == n_tokens/n_stream);
+    res &= (pos_tok->ne[3] == n_stream);
+
+    return res;
+}
+
+// either kind of mask, whichever the graph was built with
+static bool can_reuse_attn_kv_mask(
+        const llm_graph_input_attn_kv * inp,
+        const llama_kv_cache_context * mctx,
+        const llama_ubatch & ubatch,
+        const llama_cparams & cparams) {
+    if (inp->self_kq_pos_kv) {
+        return can_reuse_kq_mask_dev(inp->self_kq_pos_kv, inp->self_kq_pos_tok, mctx, ubatch, cparams);
+    }
+
+    // a graph with the host mask is rebuilt once the device mask becomes possible
+    const auto n_stream = cparams.kv_unified ? 1 : ubatch.n_seqs_unq;
+    if (mctx->can_build_kq_mask_dev(ubatch, cparams.causal_attn, n_stream)) {
+        return false;
+    }
+
+    return can_reuse_kq_mask(inp->self_kq_mask, mctx, ubatch, cparams);
+}
+
+static void set_input_attn_kv_mask(
+        const llm_graph_input_attn_kv * inp,
+        const llama_kv_cache_context * mctx,
+        const llama_ubatch * ubatch,
+        const llama_cparams & cparams) {
+    if (inp->self_kq_pos_kv) {
+        if (inp->self_kq_pos_kv->buffer && inp->self_kq_pos_tok->buffer) {
+            mctx->set_input_kq_pos(inp->self_kq_pos_kv, inp->self_kq_pos_tok, ubatch);
+        }
+        return;
+    }
+
+    if (inp->self_kq_mask && inp->self_kq_mask->buffer) {
+        mctx->set_input_kq_mask(inp->self_kq_mask, ubatch, cparams.causal_attn);
+    }
+}
