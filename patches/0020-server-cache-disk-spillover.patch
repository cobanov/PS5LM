+bool server_prompt_cache::save(const server_prompt & prompt, llama_context * ctx_tgt, llama_context * ctx_dft, int32_t id_slot) {
+    const size_t cur_size_tgt =           llama_state_seq_get_size_ext(ctx_tgt, id_slot, LLAMA_STATE_SEQ_FLAGS_NONE);
+    const size_t cur_size_dft = ctx_dft ? llama_state_seq_get_size_ext(ctx_dft, id_slot, LLAMA_STATE_SEQ_FLAGS_NONE) : 0;
+    const size_t cur_size     = cur_size_tgt + cur_size_dft;
+
+    SRV_TRC(" - saving prompt with length %d, total state size = %.3f MiB (draft: %.3f MiB)\n",
+            (int) prompt.tokens.size(), cur_size / (1024.0 * 1024.0), cur_size_dft / (1024.0 * 1024.0));
+
+    if (!ram_disabled) {
+        if (auto * cur = alloc(prompt, cur_size_tgt, cur_size_dft)) {
+            llama_state_seq_get_data_ext(ctx_tgt, cur->data.main.data(), cur_size_tgt, id_slot, LLAMA_STATE_SEQ_FLAGS_NONE);
+            if (ctx_dft) {
+                llama_state_seq_get_data_ext(ctx_dft, cur->data.drft.data(), cur_size_dft, id_slot, LLAMA_STATE_SEQ_FLAGS_NONE);
+            }
+            return true;
+        }
+    }
+
+    const size_t ckpts_est = estimate_checkpoints_bytes(prompt.checkpoints);
+    const size_t total_est = cur_size + 4096 + ckpts_est;
+    if (disk_disabled || (limit_disk_size > 0 && total_est > limit_disk_size)) {
+        return false;
+    }
+
+    for (auto it = states.begin(); it != states.end(); ++it) {
+        const int cur_lcp_len = it->prompt.tokens.get_common_prefix(prompt.tokens);
+        if (cur_lcp_len == (int) prompt.tokens.size()) {
+            SRV_TRC("%s", " - prompt is already in the cache, skipping\n");
+            return false;
+        }
+    }
+
+    for (auto it = states.begin(); it != states.end();) {
+        const int len = it->prompt.tokens.get_common_prefix(prompt.tokens);
+        if (len == (int) it->prompt.tokens.size()) {
+            remove_disk_file(*it);
+            it = states.erase(it);
+        } else {
+            ++it;
+        }
+    }
+
+    evict_disk_for(total_est);
+    if (!ensure_disk_free_space(total_est)) {
+        return false;
+    }
+
+    // Stream directly tensor-by-tensor onto SSD without allocating a giant contiguous RAM buffer.
+    const auto t_save_start = std::chrono::steady_clock::now();
+    const uint64_t fid = next_disk_id++;
+    const std::string path_tgt = (std::filesystem::path(disk_dir) / ("ps5lm_ckpt_" + std::to_string(fid) + ".seq")).string();
+    const std::string path_dft = ctx_dft
+        ? (std::filesystem::path(disk_dir) / ("ps5lm_ckpt_" + std::to_string(fid) + ".dft.seq")).string()
+        : std::string{};
+    const llama_token dummy_tok = 0;
+
+    auto stream_write_cb = [](const void * data, size_t size, void * ud) -> bool {
+        return static_cast<disk_stream_writer *>(ud)->write(data, size);
+    };
+
+    size_t wrote_tgt = 0;
+    uint64_t hash_tgt = 0;
+    {
+        disk_stream_writer writer(8u << 20);
+        if (!writer.open(path_tgt)) {
+            SRV_WRN("failed to open disk prompt cache state %s\n", path_tgt.c_str());
+            return false;
+        }
+        wrote_tgt = llama_state_seq_save_stream(ctx_tgt, id_slot, &dummy_tok, 0, stream_write_cb, &writer);
+        if (wrote_tgt == 0 || wrote_tgt != writer.bytes_written() || !writer.finish()) {
+            writer.abort();
+            std::remove(path_tgt.c_str());
+            SRV_WRN("failed to stream disk prompt cache state to %s\n", path_tgt.c_str());
+            return false;
+        }
+        hash_tgt = writer.checksum();
+    }
+
+    size_t wrote_dft = 0;
+    uint64_t hash_dft = 0;
+    if (ctx_dft) {
+        disk_stream_writer writer_dft(8u << 20);
+        if (!writer_dft.open(path_dft)) {
+            std::remove(path_tgt.c_str());
+            SRV_WRN("failed to open draft disk prompt cache state %s\n", path_dft.c_str());
+            return false;
+        }
+        wrote_dft = llama_state_seq_save_stream(ctx_dft, id_slot, &dummy_tok, 0, stream_write_cb, &writer_dft);
+        if (wrote_dft == 0 || wrote_dft != writer_dft.bytes_written() || !writer_dft.finish()) {
+            writer_dft.abort();
+            std::remove(path_tgt.c_str());
+            std::remove(path_dft.c_str());
+            SRV_WRN("failed to stream draft disk prompt cache state to %s\n", path_dft.c_str());
+            return false;
+        }
+        hash_dft = writer_dft.checksum();
+    }
+
+    std::string path_chk;
+    size_t wrote_chk = 0;
+    uint64_t hash_chk = 0;
+    if (!prompt.checkpoints.empty()) {
+        path_chk = (std::filesystem::path(disk_dir) / ("ps5lm_ckpt_" + std::to_string(fid) + ".chk")).string();
+        if (!write_checkpoints_file(path_chk, prompt.checkpoints, &wrote_chk, &hash_chk)) {
+            std::remove(path_tgt.c_str());
+            if (!path_dft.empty()) {
+                std::remove(path_dft.c_str());
+            }
+            SRV_WRN("failed to write prompt checkpoints to %s\n", path_chk.c_str());
+            return false;
+        }
+    }
+
+    states.push_back({
+        /*.prompt =*/ {
+            /*.tokens      =*/ prompt.tokens.clone(),
+            /*.checkpoints =*/ {},
+        },
+        /*.data              =*/ {},
+        /*.disk_path         =*/ path_tgt,
+        /*.disk_path_dft     =*/ path_dft,
+        /*.disk_ckpt_path    =*/ path_chk,
+        /*.disk_size_tgt     =*/ wrote_tgt,
+        /*.disk_size_dft     =*/ wrote_dft,
+        /*.disk_header_bytes =*/ 0,
+        /*.disk_ckpt_size    =*/ wrote_chk,
+        /*.disk_hash_tgt     =*/ hash_tgt,
+        /*.disk_hash_dft     =*/ hash_dft,
+        /*.disk_hash_ckpt    =*/ hash_chk,
+        /*.disk_is_seq_file  =*/ true,
+    });
+    const double save_s = std::chrono::duration<double>(std::chrono::steady_clock::now() - t_save_start).count();
+    const size_t total_saved = wrote_tgt + wrote_dft + wrote_chk;
+    const double save_mbps = save_s > 0.0 ? (total_saved / 1e6) / save_s : 0.0;
+    SRV_INF("prompt-cache: saved %.1f MiB (+ %.1f MiB chk) to disk in %.2f s (%.0f MB/s, hash=%016" PRIx64 ")\n",
+            (wrote_tgt + wrote_dft) / (1024.0 * 1024.0), wrote_chk / (1024.0 * 1024.0),
+            save_s, save_mbps, hash_tgt);
+    return true;
+}
