+void server_prompt_cache::evict_disk_for(size_t incoming_bytes) {
+    if (disk_disabled || limit_disk_size == 0) {
+        return;
+    }
+    size_t cur_disk = disk_size();
+    while (cur_disk + incoming_bytes > limit_disk_size) {
+        auto it = std::find_if(states.begin(), states.end(), [](const server_prompt_cache_state & s) {
+            return s.on_disk();
+        });
+        if (it == states.end()) {
+            break;
+        }
+        const size_t evicted = it->disk_size();
+        SRV_WRN(" - disk cache limit reached, removing oldest disk entry (size = %.3f MiB)\n",
+                evicted / (1024.0 * 1024.0));
+        remove_disk_file(*it);
+        states.erase(it);
+        cur_disk = cur_disk >= evicted ? cur_disk - evicted : 0;
+    }
+}
