+size_t llama_context::state_seq_load_stream(llama_seq_id seq_id, llama_token * tokens_out, size_t n_token_capacity, size_t * n_token_count_out, llama_state_read_cb read_cb, void * user_data) {
+    if (!read_cb) {
+        return 0;
+    }
+    llama_io_read_stream io(read_cb, user_data);
+
+    auto read_u32 = [&io]() {
+        uint32_t v = 0;
+        io.read(&v, sizeof(v));
+        return v;
+    };
+
+    const uint32_t magic   = read_u32();
+    const uint32_t version = read_u32();
+    if (magic != LLAMA_STATE_SEQ_MAGIC || version != LLAMA_STATE_SEQ_VERSION) {
+        LLAMA_LOG_ERROR("%s: unknown (magic, version) for sequence state stream: %08x, %08x\n", __func__, magic, version);
+        return 0;
+    }
+
+    const uint32_t n_token_count = read_u32();
+    if (tokens_out == nullptr) {
+        if (n_token_count_out) {
+            *n_token_count_out = n_token_count;
+        }
+        return io.n_bytes();
+    }
+    if (n_token_count > n_token_capacity) {
+        LLAMA_LOG_ERROR("%s: token count in sequence state stream exceeded capacity! %u > %zu\n", __func__, n_token_count, n_token_capacity);
+        return 0;
+    }
+    if (n_token_count > 0) {
+        io.read(tokens_out, sizeof(llama_token) * n_token_count);
+    }
+    if (n_token_count_out) {
+        *n_token_count_out = n_token_count;
+    }
+
+    const size_t hdr_bytes = io.n_bytes();
+    const size_t nread = state_seq_read_data(io, seq_id, 0);
+    if (nread <= hdr_bytes || nread != io.n_bytes()) {
+        LLAMA_LOG_ERROR("%s: failed to restore sequence state (nread=%zu, io=%zu)\n", __func__, nread, io.n_bytes());
+        return 0;
+    }
+    return io.n_bytes();
+}
