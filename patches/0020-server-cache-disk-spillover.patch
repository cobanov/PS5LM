+        return fd_ >= 0 && posix_write_all(fd_, data, size);
+    }
+
+    bool flush_buf() {
+        if (buf_.empty()) {
+            return true;
+        }
+        const bool ok = flush_raw(buf_.data(), buf_.size());
+        buf_.clear();
+        return ok;
+    }
+
+    std::string          final_path_;
+    std::string          part_path_;
+    size_t               buf_cap_;
+    std::vector<uint8_t> buf_;
+    int                  fd_        = -1;
+    bool                 use_ftp_   = false;
+    bool                 open_      = false;
+    bool                 committed_ = false;
+    size_t               bytes_     = 0;
+    uint64_t             hash_      = kFnv1aOffset;
+};
+
+class disk_stream_reader {
+public:
+    explicit disk_stream_reader(size_t buf_cap = (4u << 20)) : buf_cap_(std::max<size_t>(buf_cap, 4096)) {}
+
+    ~disk_stream_reader() {
+        close();
+    }
+
+    disk_stream_reader(const disk_stream_reader &)             = delete;
+    disk_stream_reader & operator=(const disk_stream_reader &) = delete;
+
+    bool open(const std::string & path) {
+        close();
+#ifdef _WIN32
+        fd_ = ::_open(path.c_str(), _O_RDONLY | _O_BINARY);
+#else
+        fd_ = ::open(path.c_str(), O_RDONLY);
+#endif
+        if (fd_ < 0) {
+            return false;
+        }
+        buf_.resize(buf_cap_);
+        pos_        = 0;
+        len_        = 0;
+        bytes_read_ = 0;
+        hash_       = kFnv1aOffset;
+        return true;
+    }
+
+    bool read(void * dst, size_t size) {
+        if (fd_ < 0) {
+            return false;
+        }
+        uint8_t * out = static_cast<uint8_t *>(dst);
+        while (size > 0) {
+            if (pos_ < len_) {
+                const size_t avail = len_ - pos_;
+                const size_t take  = std::min(size, avail);
+                std::memcpy(out, buf_.data() + pos_, take);
+                hash_        = fnv1a_update(hash_, out, take);
+                bytes_read_ += take;
+                pos_        += take;
+                out         += take;
+                size        -= take;
+                continue;
+            }
+            if (size >= buf_cap_) {
+                const size_t got = read_some(out, size);
+                if (got == 0) {
+                    return false;
+                }
+                hash_        = fnv1a_update(hash_, out, got);
+                bytes_read_ += got;
+                out         += got;
+                size        -= got;
+                continue;
+            }
+            pos_ = 0;
+            len_ = read_some(buf_.data(), buf_cap_);
+            if (len_ == 0) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    bool at_eof() {
+        if (fd_ < 0) {
+            return true;
+        }
+        if (pos_ < len_) {
+            return false;
+        }
+        pos_ = 0;
+        len_ = read_some(buf_.data(), buf_cap_);
+        return len_ == 0;
+    }
+
+    size_t bytes_read() const {
+        return bytes_read_;
+    }
+
+    uint64_t checksum() const {
+        return hash_;
+    }
+
+    void close() {
+        std::vector<uint8_t>().swap(buf_);
+        pos_ = 0;
+        len_ = 0;
+        if (fd_ >= 0) {
+#ifdef _WIN32
+            ::_close(fd_);
+#else
+            ::close(fd_);
+#endif
+            fd_ = -1;
+        }
+    }
+
+private:
+    size_t read_some(void * dst, size_t size) {
+#ifdef _WIN32
+        const unsigned int req = (unsigned int) std::min<size_t>(size, 1u << 24);
+        while (true) {
+            const int n = ::_read(fd_, dst, req);
+            if (n < 0 && errno == EINTR) {
+                continue;
+            }
+            return n > 0 ? (size_t) n : 0;
+        }
+#else
+        while (true) {
+            const ssize_t n = ::read(fd_, dst, size);
+            if (n < 0 && errno == EINTR) {
+                continue;
+            }
+            return n > 0 ? (size_t) n : 0;
+        }
+#endif
+    }
+
+    size_t               buf_cap_;
+    std::vector<uint8_t> buf_;
+    int                  fd_         = -1;
+    size_t               pos_        = 0;
+    size_t               len_        = 0;
+    size_t               bytes_read_ = 0;
+    uint64_t             hash_       = kFnv1aOffset;
+};
+
+size_t estimate_checkpoints_bytes(const std::list<common_prompt_checkpoint> & ckpts) {
+    if (ckpts.empty()) {
+        return 0;
+    }
+    size_t total = sizeof(uint32_t) * 3 + sizeof(uint64_t);
+    for (const auto & ckpt : ckpts) {
+        total += sizeof(int64_t) + sizeof(llama_pos) * 2 + sizeof(uint64_t) * 3
+               + ckpt.data_tgt.size() + ckpt.data_dft.size() + ckpt.data_spec.size();
+    }
+    return total;
+}
