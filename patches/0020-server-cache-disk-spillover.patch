+class llama_io_write_stream : public llama_io_write_i {
+public:
+    llama_io_write_stream(llama_state_write_cb cb, void * ud) : write_cb(cb), user_data(ud) {}
+
+    void write(const void * src, size_t size) override {
+        if (size > 0 && !write_cb(src, size, user_data)) {
+            throw std::runtime_error("failed to write sequence state stream");
+        }
+        size_written += size;
+    }
+
+    void write_tensor(ggml_tensor * tensor, size_t offset, size_t size) override {
+        constexpr size_t kChunk = 4u << 20;
+        temp_buffer.resize(std::min(size, kChunk));
+        size_t done = 0;
+        while (done < size) {
+            const size_t n = std::min(kChunk, size - done);
+            ggml_backend_tensor_get(tensor, temp_buffer.data(), offset + done, n);
+            write(temp_buffer.data(), n);
+            done += n;
+        }
+    }
+
+    size_t n_bytes() override {
+        return size_written;
+    }
+
+private:
+    llama_state_write_cb write_cb;
+    void *               user_data;
+    size_t               size_written = 0;
+    std::vector<uint8_t> temp_buffer;
+};
+
+class llama_io_read_stream : public llama_io_read_i {
+public:
+    llama_io_read_stream(llama_state_read_cb cb, void * ud) : read_cb(cb), user_data(ud) {}
+
+    void read(void * dst, size_t size) override {
+        if (size > 0 && !read_cb(dst, size, user_data)) {
+            throw std::runtime_error("failed to read sequence state stream");
+        }
+        size_read += size;
+    }
+
+    void read_tensor(ggml_tensor * tensor, size_t offset, size_t size) override {
+        constexpr size_t kChunk = 4u << 20;
+        temp_buffer.resize(std::min(size, kChunk));
+        size_t done = 0;
+        while (done < size) {
+            const size_t n = std::min(kChunk, size - done);
+            read(temp_buffer.data(), n);
+            ggml_backend_tensor_set(tensor, temp_buffer.data(), offset + done, n);
+            done += n;
+        }
+    }
+
+    size_t n_bytes() override {
+        return size_read;
+    }
+
+private:
+    llama_state_read_cb  read_cb;
+    void *               user_data;
+    size_t               size_read = 0;
+    std::vector<uint8_t> temp_buffer;
+};
