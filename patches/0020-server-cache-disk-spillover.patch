+server_prompt_cache::server_prompt_cache(
+        int32_t limit_size_mib, size_t limit_tokens,
+        std::string disk_dir, int32_t limit_disk_mib) {
+    this->ram_disabled = (limit_size_mib == 0);
+    this->limit_size   = limit_size_mib > 0 ? 1024ull * 1024ull * uint64_t(limit_size_mib) : 0;
+    this->limit_tokens = limit_tokens;
+    this->disk_dir     = std::move(disk_dir);
+    this->disk_disabled = this->disk_dir.empty() || limit_disk_mib < 0;
+    this->limit_disk_size = limit_disk_mib > 0 ? 1024ull * 1024ull * uint64_t(limit_disk_mib) : 0;
+
+    if (!this->disk_disabled) {
+        std::error_code ec;
+        std::filesystem::create_directories(this->disk_dir, ec);
+        if (ec) {
+            SRV_WRN("failed to create disk prompt cache directory %s: %s\n",
+                    this->disk_dir.c_str(), ec.message().c_str());
+            this->disk_disabled = true;
+        } else {
+            const auto ends_with = [](const std::string & s, const char * suf) {
+                const size_t n = std::strlen(suf);
+                return s.size() >= n && s.compare(s.size() - n, n, suf) == 0;
+            };
+            // Sweep stale checkpoint and partial temp files left by any prior hard crash.
+            for (const auto & entry : std::filesystem::directory_iterator(this->disk_dir, ec)) {
+                if (ec) {
+                    break;
+                }
+                const std::string name = entry.path().filename().string();
+                if (name.rfind("ps5lm_ckpt_", 0) == 0 &&
+                    (ends_with(name, ".bin") || ends_with(name, ".seq") || ends_with(name, ".chk") || ends_with(name, ".part"))) {
+                    std::error_code rm_ec;
+                    std::filesystem::remove(entry.path(), rm_ec);
+                }
+            }
+        }
+    }
+}
