+size_t llama_context::state_seq_save_stream(llama_seq_id seq_id, const llama_token * tokens, size_t n_token_count, llama_state_write_cb write_cb, void * user_data) {
+    if (!write_cb) {
+        return 0;
+    }
+    llama_io_write_stream io(write_cb, user_data);
+
+    const uint32_t magic   = LLAMA_STATE_SEQ_MAGIC;
+    const uint32_t version = LLAMA_STATE_SEQ_VERSION;
+    const uint32_t n_tok   = (uint32_t) n_token_count;
+
+    io.write(&magic,   sizeof(magic));
+    io.write(&version, sizeof(version));
+    io.write(&n_tok,   sizeof(n_tok));
+    if (n_token_count > 0) {
+        io.write(tokens, sizeof(llama_token) * n_token_count);
+    }
+
+    state_seq_write_data(io, seq_id, 0);
+    const size_t res = io.n_bytes();
+    GGML_ASSERT(res >= sizeof(uint32_t) * 3 + sizeof(llama_token) * n_token_count);
+    return res;
+}
