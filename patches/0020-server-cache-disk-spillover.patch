+bool server_prompt_cache::write_disk_blob(
+        const std::string & path,
+        const uint8_t * tgt, size_t tgt_size,
+        const uint8_t * dft, size_t dft_size,
+        size_t * out_header_bytes,
+        uint64_t * out_hash) {
+    disk_stream_writer writer(8u << 20);
+    if (!writer.open(path)) {
+        return false;
+    }
+    const char magic[4] = {'P', 'C', 'K', '1'};
+    const uint64_t hdr[2] = {uint64_t(tgt_size), uint64_t(dft_size)};
+    bool ok = writer.write(magic, sizeof(magic))
+           && writer.write(hdr, sizeof(hdr))
+           && (tgt_size == 0 || writer.write(tgt, tgt_size))
+           && (dft_size == 0 || writer.write(dft, dft_size));
+    const uint64_t payload_hash = writer.checksum();
+    ok = ok && writer.write(&payload_hash, sizeof(payload_hash)) && writer.finish();
+    if (!ok) {
+        writer.abort();
+        return false;
+    }
+    if (out_header_bytes) {
+        *out_header_bytes = sizeof(magic) + sizeof(hdr) + sizeof(payload_hash);
+    }
+    if (out_hash) {
+        *out_hash = payload_hash;
+    }
+    return true;
+}
+
+bool server_prompt_cache::read_disk_blob(
+        const std::string & path, size_t tgt_size, size_t dft_size,
+        uint64_t expected_hash,
+        std::vector<uint8_t> & tgt_out, std::vector<uint8_t> & dft_out) {
+    disk_stream_reader reader(4u << 20);
+    if (!reader.open(path)) {
+        return false;
+    }
+    char magic[4] = {};
+    uint64_t hdr[2] = {};
+    bool ok = reader.read(magic, sizeof(magic))
+           && std::memcmp(magic, "PCK1", 4) == 0
+           && reader.read(hdr, sizeof(hdr))
+           && hdr[0] == uint64_t(tgt_size)
+           && hdr[1] == uint64_t(dft_size);
+    if (ok) {
+        try {
+            tgt_out.resize(tgt_size);
+            if (tgt_size > 0 && !reader.read(tgt_out.data(), tgt_size)) {
+                ok = false;
+            }
+            if (ok && dft_size > 0) {
+                dft_out.resize(dft_size);
+                if (!reader.read(dft_out.data(), dft_size)) {
+                    ok = false;
+                }
+            }
+        } catch (const std::bad_alloc & e) {
+            SRV_WRN("failed to allocate transient buffer reading disk cache %s: %s\n", path.c_str(), e.what());
+            ok = false;
+        }
+    }
+    if (ok) {
+        const uint64_t computed_hash = reader.checksum();
+        uint64_t footer_hash = 0;
+        ok = reader.read(&footer_hash, sizeof(footer_hash))
+          && computed_hash == footer_hash
+          && (expected_hash == 0 || computed_hash == expected_hash)
+          && reader.at_eof();
+    }
+    reader.close();
+    if (!ok) {
+        tgt_out.clear();
+        tgt_out.shrink_to_fit();
+        dft_out.clear();
+        dft_out.shrink_to_fit();
+    }
+    return ok;
+}
+
+bool server_prompt_cache::write_checkpoints_file(
+        const std::string & path,
+        const std::list<common_prompt_checkpoint> & ckpts,
+        size_t * out_bytes,
+        uint64_t * out_hash) {
+    disk_stream_writer writer(1u << 20);
+    if (!writer.open(path)) {
+        return false;
+    }
+    const uint32_t magic   = kPchkMagic;
+    const uint32_t version = kPchkVersion;
+    const uint32_t count   = (uint32_t) ckpts.size();
+    bool ok = writer.write(&magic, sizeof(magic))
+           && writer.write(&version, sizeof(version))
+           && writer.write(&count, sizeof(count));
+    for (const auto & ckpt : ckpts) {
+        if (!ok) {
+            break;
+        }
+        const int64_t   n_tokens = ckpt.n_tokens;
+        const llama_pos pos_min  = ckpt.pos_min;
+        const llama_pos pos_max  = ckpt.pos_max;
+        const uint64_t  sz_tgt   = ckpt.data_tgt.size();
+        const uint64_t  sz_dft   = ckpt.data_dft.size();
+        const uint64_t  sz_spec  = ckpt.data_spec.size();
+        ok = writer.write(&n_tokens, sizeof(n_tokens))
+          && writer.write(&pos_min, sizeof(pos_min))
+          && writer.write(&pos_max, sizeof(pos_max))
+          && writer.write(&sz_tgt, sizeof(sz_tgt))
+          && writer.write(&sz_dft, sizeof(sz_dft))
+          && writer.write(&sz_spec, sizeof(sz_spec))
+          && (sz_tgt == 0 || writer.write(ckpt.data_tgt.data(), sz_tgt))
+          && (sz_dft == 0 || writer.write(ckpt.data_dft.data(), sz_dft))
+          && (sz_spec == 0 || writer.write(ckpt.data_spec.data(), sz_spec));
+    }
+    const uint64_t payload_hash = writer.checksum();
+    ok = ok && writer.write(&payload_hash, sizeof(payload_hash)) && writer.finish();
+    if (!ok) {
+        writer.abort();
+        return false;
+    }
+    if (out_bytes) {
+        *out_bytes = writer.bytes_written();
+    }
+    if (out_hash) {
+        *out_hash = payload_hash;
+    }
+    return true;
+}
+
+bool server_prompt_cache::read_checkpoints_file(
+        const std::string & path,
+        uint64_t expected_hash,
+        std::list<common_prompt_checkpoint> & out) {
+    out.clear();
+    disk_stream_reader reader(1u << 20);
+    if (!reader.open(path)) {
+        return false;
+    }
+    uint32_t magic = 0, version = 0, count = 0;
+    bool ok = reader.read(&magic, sizeof(magic))
+           && reader.read(&version, sizeof(version))
+           && reader.read(&count, sizeof(count))
+           && magic == kPchkMagic
+           && version == kPchkVersion
+           && count <= 4096;
+    for (uint32_t i = 0; ok && i < count; ++i) {
+        common_prompt_checkpoint ckpt;
+        ckpt.id_task = -1;
+        uint64_t sz_tgt = 0, sz_dft = 0, sz_spec = 0;
+        ok = reader.read(&ckpt.n_tokens, sizeof(ckpt.n_tokens))
+          && reader.read(&ckpt.pos_min, sizeof(ckpt.pos_min))
+          && reader.read(&ckpt.pos_max, sizeof(ckpt.pos_max))
+          && reader.read(&sz_tgt, sizeof(sz_tgt))
+          && reader.read(&sz_dft, sizeof(sz_dft))
+          && reader.read(&sz_spec, sizeof(sz_spec));
+        if (!ok || sz_tgt > (8ull << 30) || sz_dft > (8ull << 30) || sz_spec > (1ull << 30)) {
+            ok = false;
+            break;
+        }
+        try {
+            ckpt.data_tgt.resize(sz_tgt);
+            ckpt.data_dft.resize(sz_dft);
+            ckpt.data_spec.resize(sz_spec);
+        } catch (const std::bad_alloc & e) {
+            SRV_WRN("failed to allocate buffer reading checkpoints %s: %s\n", path.c_str(), e.what());
+            ok = false;
+            break;
+        }
+        ok = (sz_tgt == 0 || reader.read(ckpt.data_tgt.data(), sz_tgt))
+          && (sz_dft == 0 || reader.read(ckpt.data_dft.data(), sz_dft))
+          && (sz_spec == 0 || reader.read(ckpt.data_spec.data(), sz_spec));
+        if (ok) {
+            out.push_back(std::move(ckpt));
+        }
+    }
+    if (ok) {
+        const uint64_t computed_hash = reader.checksum();
+        uint64_t footer_hash = 0;
+        ok = reader.read(&footer_hash, sizeof(footer_hash))
+          && computed_hash == footer_hash
+          && (expected_hash == 0 || computed_hash == expected_hash)
+          && reader.at_eof();
+    }
+    reader.close();
+    if (!ok) {
+        out.clear();
+    }
+    return ok;
+}
