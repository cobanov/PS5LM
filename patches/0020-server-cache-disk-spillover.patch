+bool server_prompt_cache::ensure_disk_free_space(size_t incoming_bytes) {
+    if (disk_disabled) {
+        return false;
+    }
+    std::error_code ec;
+    const auto sp = std::filesystem::space(disk_dir, ec);
+    if (ec || sp.available == static_cast<uintmax_t>(-1)) {
+        return true;
+    }
+    constexpr size_t kMinFreeHeadroom = 128ull << 20;
+    const uint64_t need = uint64_t(incoming_bytes) + kMinFreeHeadroom;
+    uint64_t avail = sp.available;
+    while (avail < need) {
+        auto it = std::find_if(states.begin(), states.end(), [](const server_prompt_cache_state & s) {
+            return s.on_disk();
+        });
+        if (it == states.end()) {
+            break;
+        }
+        const size_t evicted = it->disk_size();
+        SRV_WRN(" - low free disk space (%.1f MiB available), removing oldest disk entry (size = %.3f MiB)\n",
+                avail / (1024.0 * 1024.0), evicted / (1024.0 * 1024.0));
+        remove_disk_file(*it);
+        states.erase(it);
+        avail += evicted;
+    }
+    const auto sp_after = std::filesystem::space(disk_dir, ec);
+    if (!ec && sp_after.available != static_cast<uintmax_t>(-1) && sp_after.available < need) {
+        SRV_WRN("prompt-cache: insufficient free disk space in %s (%.1f MiB available, need %.1f MiB), skipping disk save\n",
+                disk_dir.c_str(), sp_after.available / (1024.0 * 1024.0), need / (1024.0 * 1024.0));
+        return false;
+    }
+    return true;
+}
