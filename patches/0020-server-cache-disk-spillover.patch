+bool posix_write_all(int fd, const void * data, size_t size) {
+    const uint8_t * p = static_cast<const uint8_t *>(data);
+    size_t left = size;
+    while (left > 0) {
+#ifdef _WIN32
+        const unsigned int chunk = (unsigned int) std::min<size_t>(left, 1u << 24);
+        const int n = ::_write(fd, p, chunk);
+#else
