 // so that both sides clear their caches at the same point in the message stream
 const size_t GRAPH_CACHE_MAX = 1024;
 
+// PS5LM: a server keeps every graph it is sent (tensors and all, some MiB for a
+// large model) until GRAPH_CACHE_MAX of them have come, and a client sends a new
+// one for each prompt batch whose shape differs from the last: a worker lost
+// about 4 MiB per batch read, up to 4 GiB. A server that sets this bit in its
+// HELLO answer (the byte was padding, 0 from older servers) takes
+// RPC_CMD_GRAPH_FREE, and a client that sees it keeps only the GRAPH_CACHE_KEEP
+// graphs it used last on each device and tells the server to free the others.
+// Either side alone behaves as before.
+const uint8_t RPC_FEATURE_GRAPH_FREE = 1;
+const size_t  GRAPH_CACHE_KEEP       = 8;
+
