@@ -127,6 +130,18 @@ const size_t HASH_THRESHOLD = 10 * 1024 * 1024;
 // so that both sides clear their caches at the same point in the message stream
 const size_t GRAPH_CACHE_MAX = 1024;
 
+// PS5LM: a server keeps every graph it is sent (tensors and all, some MiB for a
+// large model) until GRAPH_CACHE_MAX of them have come, and a client sends a new
+// one for each prompt batch whose shape differs from the last: a worker lost
+// about 4 MiB per batch read, up to 4 GiB. A server that sets this bit in the
+// flags byte of its HELLO answer (rpc_dispatcher_flags counts up from bit 0, the
+// PS5LM bits down from bit 7; 0 from a server without the patch) takes
+// RPC_CMD_GRAPH_FREE, and a client that sees it keeps only the GRAPH_CACHE_KEEP
+// graphs it used last on each device and tells the server to free the others.
+// Either side alone behaves as before.
+const uint8_t RPC_FEATURE_GRAPH_FREE = 1 << 6;
+const size_t  GRAPH_CACHE_KEEP       = 8;
+
 struct rpc_msg_hello_req {
     uint8_t conn_caps[RPC_CONN_CAPS_SIZE];
 };
@@ -251,6 +266,11 @@ struct rpc_msg_graph_recompute_req {
     uint64_t uid;
 };
 
+struct rpc_msg_graph_free_req {
+    uint32_t device;
+    uint64_t uid;
+};
+
 struct rpc_msg_get_tensor_2d_req {
     rpc_tensor tensor;
     uint64_t offset;
@@ -568,6 +588,9 @@ private:
     socket_ptr    sock;
 
