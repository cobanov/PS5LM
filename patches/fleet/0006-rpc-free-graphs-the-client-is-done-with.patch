+// The client will not compute this graph again (it re-sends one it does want).
+// An unknown uid is not an error: a full cache or a freed buffer may have dropped it.
+bool rpc_server::graph_free(const rpc_msg_graph_free_req & request) {
+    if (request.device >= backends.size()) {
+        return false;
+    }
+    // a compute still running may be reading the graph
+    sync_all_backends();
+    const size_t n = stored_graphs[request.device].erase(request.uid);
+    LOG_DBG("[%s] device: %u, uid: %" PRIu64 ", %s\n", __func__, request.device, request.uid, n ? "freed" : "not held");
+    return true;
+}
+
 // graph compute is asynchronous; commands that read or write buffer data synchronize first
 void rpc_server::sync_all_backends() {
     for (ggml_backend_t backend : backends) {
