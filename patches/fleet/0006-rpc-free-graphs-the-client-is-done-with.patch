+    // with graph_free: the same uids, most recently computed first
+    std::unordered_map<uint32_t, std::list<uint64_t>> graph_lru;
+    bool graph_free = false;
 
     std::atomic_uint busy_spin_users = 0;
     std::atomic_bool running;
@@ -671,6 +694,7 @@ bool rpc_dispatcher::start(const std::string & endpoint) {
         LOG_ERROR("RPC handshake failed for %s\n", endpoint.c_str());
         return false;
     }
+    graph_free = (flags & RPC_FEATURE_GRAPH_FREE) != 0 && std::getenv("GGML_RPC_NO_GRAPH_FREE") == nullptr;
     LOG_DBG("[%s] connected to %s\n", __func__, endpoint.c_str());
     running = true;
     thread = std::thread(rpc_dispatcher_trampoline, this);
@@ -1280,6 +1304,27 @@ void rpc_dispatcher::graph_compute(uint32_t device, const ggml_cgraph * cgraph)
     auto & device_graph_uids = graph_uids[device];
     bool reuse = cgraph->uid != 0 && device_graph_uids.count(cgraph->uid) > 0;
     LOG_DBG("[%s] device: %u, uid: %" PRIu64 ", n_nodes: %u, reuse: %s\n", __func__, device, cgraph->uid, cgraph->n_nodes, reuse ? "yes" : "no");
+    if (graph_free && cgraph->uid != 0) {
+        // the graphs used last stay on the server, and it frees the one this pushes out
+        auto & lru = graph_lru[device];
+        lru.remove(cgraph->uid);
+        lru.push_front(cgraph->uid);
+        // GGML_RPC_GRAPH_KEEP: how many the worker keeps for this client (default GRAPH_CACHE_KEEP, at least 1).
+        // Each is a copy of the graph with all its tensors on the worker (about 4 MiB for a 27B model).
+        static const size_t keep = [] {
+            const char * e = getenv("GGML_RPC_GRAPH_KEEP");
+            const long v = e ? atol(e) : 0;
+            return v > 0 ? (size_t) v : GRAPH_CACHE_KEEP;
+        }();
+        while (lru.size() > keep) {
+            auto request = std::make_shared<rpc_msg_graph_free_req>();
+            request->device = device;
+            request->uid    = lru.back();
+            device_graph_uids.erase(lru.back());
+            lru.pop_back();
+            send_async(RPC_CMD_GRAPH_FREE, request, sizeof(*request));
+        }
+    }
     if (reuse) {
         auto request = std::make_shared<rpc_msg_graph_recompute_req>();
         request->device = device;
@@ -1291,6 +1336,7 @@ void rpc_dispatcher::graph_compute(uint32_t device, const ggml_cgraph * cgraph)
                 LOG_DBG("[%s] clearing graph cache for device %u (%zu entries)\n",
                         __func__, device, device_graph_uids.size());
                 device_graph_uids.clear();
+                graph_lru[device].assign(1, cgraph->uid);
             }
             device_graph_uids.insert(cgraph->uid);
         }
