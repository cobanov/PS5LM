+// PS5LM device parking (park.h). Every answer is a status: a park command that
+// fails does not drop the client. Tensor data moves between the device and the
+// file through the store's one buffer, PARK_BUF_SIZE at a time, so a save or a
+// load of any size takes no more memory than that. The bytes of WRITE_DATA come
+// in that buffer and the data of an answer leaves in it. False only for a request
+// whose answer would not have the size the client waits for.
+bool rpc_server::park_cmd(const rpc_msg_park_req & request, size_t payload_size, ggml_rpc_park_rsp & rsp, size_t & out_size) {
+    using namespace ggml_rpc_park;
+    ggml_rpc_park_req req = request.req;
+    req.key[sizeof(req.key) - 1]   = '\0';
+    req.file[sizeof(req.file) - 1] = '\0';
+    memset(&rsp, 0, sizeof(rsp));
+    out_size = 0;
+    const bool has_out = req.op == GGML_RPC_PARK_READ_DATA || req.op == GGML_RPC_PARK_LIST || req.op == GGML_RPC_PARK_LIST_FILES;
+    if (has_out) {
+        if (req.size > PARK_BUF_SIZE) {
+            return false;
+        }
+        out_size = req.size;
+        memset(park.buffer(), 0, out_size);
+    }
+    const auto done = [&](int status, const std::string & text) {
+        rsp.status = status;
+        snprintf(rsp.msg, sizeof(rsp.msg), "%s", text.c_str());
+        return true;
+    };
+    if (!park.enabled()) {
+        return done(GGML_RPC_PARK_BAD, "this worker has no folder for parked state");
+    }
+    uint8_t * buf = park.buffer();
+    switch (req.op) {
+        case GGML_RPC_PARK_STAT: {
+            park.stat(rsp.v[0], rsp.v[1], rsp.v[2], rsp.v[3]);
+            return true;
+        }
+        case GGML_RPC_PARK_LIST: {
+            const auto keys = park.keys();
+            auto * out = (ggml_rpc_park_key_entry *) buf;
+            const size_t room = out_size / sizeof(*out);
+            size_t n = 0;
+            for (size_t i = req.arg; i < keys.size() && n < room; i++, n++) {
+                snprintf(out[n].key, sizeof(out[n].key), "%s", keys[i].name.c_str());
+                out[n].bytes   = keys[i].bytes;
+                out[n].n_files = keys[i].n_files;
+                out[n].mtime   = keys[i].mtime;
+            }
+            rsp.v[0] = n;
+            rsp.v[1] = keys.size();
+            return true;
+        }
+        case GGML_RPC_PARK_LIST_FILES: {
+            if (!name_ok(req.key, sizeof(req.key), sizeof(req.key) - 1)) {
+                return done(GGML_RPC_PARK_BAD, "invalid key");
+            }
+            const auto files = park.files(req.key);
+            auto * out = (ggml_rpc_park_file_entry *) buf;
+            const size_t room = out_size / sizeof(*out);
+            size_t n = 0;
+            for (size_t i = req.arg; i < files.size() && n < room; i++, n++) {
+                snprintf(out[n].file, sizeof(out[n].file), "%s", files[i].name.c_str());
+                out[n].bytes = files[i].bytes;
+                out[n].mtime = files[i].mtime;
+            }
+            rsp.v[0] = n;
+            rsp.v[1] = files.size();
+            return true;
+        }
+        case GGML_RPC_PARK_DELETE: {
+            return done(park.remove(req.key, req.file, rsp.v[0], rsp.v[1]), park.error());
+        }
+        case GGML_RPC_PARK_WRITE_BEGIN: {
+            uint32_t n_pruned = 0;
+            const int status = park.write_begin(req.key, req.file, req.size, n_pruned);
+            rsp.v[0] = n_pruned;
+            return done(status, park.error());
+        }
+        case GGML_RPC_PARK_WRITE_DATA: {
+            if (payload_size != req.size) {
+                return done(GGML_RPC_PARK_BAD, "WRITE_DATA without its bytes");
+            }
+            return done(park.write(buf, payload_size), park.error());
+        }
+        case GGML_RPC_PARK_WRITE_COMMIT: {
+            return done(park.write_commit(rsp.v[0], rsp.v[1]), park.error());
+        }
+        case GGML_RPC_PARK_WRITE_ABORT: {
+            park.write_abort();
+            return true;
+        }
+        case GGML_RPC_PARK_READ_BEGIN: {
+            return done(park.read_begin(req.key, req.file, req.offset, rsp.v[0]), park.error());
+        }
+        case GGML_RPC_PARK_READ_DATA: {
+            const int status = park.read(buf, req.size);
+            if (status != GGML_RPC_PARK_OK) {
+                memset(buf, 0, out_size);
+            }
+            return done(status, park.error());
+        }
+        case GGML_RPC_PARK_READ_END: {
+            return done(park.read_end(rsp.v[0], rsp.v[1]), park.error());
+        }
+        case GGML_RPC_PARK_WRITE_TENSOR:
+        case GGML_RPC_PARK_READ_TENSOR: {
+            // a compute still running may be writing the tensor
+            sync_all_backends();
+            struct ggml_init_params params {
+                /*.mem_size   =*/ ggml_tensor_overhead(),
+                /*.mem_buffer =*/ NULL,
+                /*.no_alloc   =*/ true,
+            };
+            ggml_context_ptr ctx_ptr { ggml_init(params) };
+            GGML_ASSERT(ctx_ptr != nullptr);
+            ggml_tensor * tensor = deserialize_tensor(ctx_ptr.get(), &request.tensor);
+            if (tensor == nullptr || tensor->buffer == nullptr) {
+                return done(GGML_RPC_PARK_BAD, "not a tensor of this worker");
+            }
+            const size_t p0 = (size_t) ggml_backend_buffer_get_base(tensor->buffer);
+            const size_t p1 = p0 + ggml_backend_buffer_get_size(tensor->buffer);
+            if (request.tensor.data + req.offset < p0 || request.tensor.data + req.offset >= p1 ||
+                req.size > (p1 - request.tensor.data - req.offset)) {
+                return done(GGML_RPC_PARK_BAD, "tensor range out of its buffer");
+            }
+            const bool writing = req.op == GGML_RPC_PARK_WRITE_TENSOR;
+            for (uint64_t at = 0; at < req.size; ) {
+                const size_t n = (size_t) std::min<uint64_t>(PARK_BUF_SIZE, req.size - at);
+                int status;
+                if (writing) {
+                    ggml_backend_tensor_get(tensor, buf, req.offset + at, n);
+                    status = park.write(buf, n);
+                } else {
+                    status = park.read(buf, n);
+                    if (status == GGML_RPC_PARK_OK) {
+                        ggml_backend_tensor_set(tensor, buf, req.offset + at, n);
+                    }
+                }
+                if (status != GGML_RPC_PARK_OK) {
+                    return done(status, park.error());
+                }
+                at += n;
+            }
+            rsp.v[0] = req.size;
+            return true;
+        }
+        default:
+            return done(GGML_RPC_PARK_BAD, "unknown park command");
+    }
+}
