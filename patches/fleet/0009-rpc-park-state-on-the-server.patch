+bool ggml_backend_rpc_park(const char * endpoint, const ggml_tensor * tensor, const ggml_rpc_park_req * req,
+                           const void * data_in, void * data_out, ggml_rpc_park_rsp * rsp) {
+    std::shared_ptr<rpc_dispatcher> dispatcher;
+    if (tensor != nullptr) {
+        if (tensor->buffer == nullptr || !ggml_backend_buffer_is_rpc(tensor->buffer)) {
+            return false;
+        }
+        dispatcher = ((ggml_backend_rpc_buffer_context *) tensor->buffer->context)->dispatcher;
+    } else if (endpoint != nullptr) {
+        dispatcher = get_dispatcher(endpoint);
+    }
+    if (!dispatcher || !dispatcher->park) {
+        return false;
+    }
+    const bool has_in  = req->op == GGML_RPC_PARK_WRITE_DATA;
+    const bool has_out = req->op == GGML_RPC_PARK_READ_DATA || req->op == GGML_RPC_PARK_LIST || req->op == GGML_RPC_PARK_LIST_FILES;
+    if ((has_in || has_out) && (req->size > GGML_RPC_PARK_MAX_DATA || (has_in ? data_in : data_out) == nullptr)) {
+        return false;
+    }
+    const size_t in_size = sizeof(rpc_msg_park_req) + (has_in ? req->size : 0);
+    std::shared_ptr<uint8_t> input(new uint8_t[in_size], std::default_delete<uint8_t[]>());
+    rpc_msg_park_req head;
+    memset(&head, 0, sizeof(head));
+    head.req    = *req;
+    head.tensor = serialize_tensor(tensor);
+    memcpy(input.get(), &head, sizeof(head));
+    if (has_in) {
+        memcpy(input.get() + sizeof(head), data_in, req->size);
+    }
+    if (!has_out) {
+        dispatcher->send(RPC_CMD_PARK, input, in_size, nullptr, 0, rsp, sizeof(*rsp));
+        return true;
+    }
+    std::vector<uint8_t> output(sizeof(*rsp) + req->size);
+    dispatcher->send(RPC_CMD_PARK, input, in_size, nullptr, 0, output.data(), output.size());
+    memcpy(rsp, output.data(), sizeof(*rsp));
+    memcpy(data_out, output.data() + sizeof(*rsp), req->size);
+    return true;
+}
