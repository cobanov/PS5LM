     if (std::strcmp(name, "ggml_backend_comm_init") == 0) {
         return (void *)ggml_backend_rpc_comm_init;
     }
diff --git a/ggml/src/ggml-rpc/park.h b/ggml/src/ggml-rpc/park.h
new file mode 100644
index 000000000..dc60b2af7
--- /dev/null
+++ b/ggml/src/ggml-rpc/park.h
@@ -0,0 +1,708 @@
+// PS5LM device parking: the files an RPC worker keeps for its clients.
+//
+// A client (llama-server) parks the state of a conversation on the worker's own
+// storage instead of fetching it: for each key a folder of files under
+// GGML_RPC_PARK_DIR, each written once, in order, under a temporary name and
+// renamed when whole, so a reader sees a file completely or not at all. Every
+// byte goes through one buffer of PARK_BUF_SIZE: nothing here grows with the
+// size of the state. The folder is kept under GGML_RPC_PARK_GB (default 128) and
+// the disk above GGML_RPC_PARK_RESERVE_GB free (default 16) by dropping whole
+// keys, least recently used first, never one with a file open and never the one
+// restored last. "Used" is a save or a restore, and the server keeps that order
+// itself, in the file .used of the folder: a PS5's file times move when a key is
+// saved but not when it is read, so by them a neuron restored a minute ago
+// looked older than one saved an hour ago and was dropped for it.
+//
+// A PS5 title's own writes to /data slow to about 1.2 MB/s after 2 GB, so a title
+// that defines ps5lm_rpc_park_write (PS5LM does) writes the files through it:
+// op 0 begin (path), 1 data, 2 end, 3 abort; 1 done, 0 failed, -1 no writer.
+#pragma once
+
+#include <algorithm>
+#include <cerrno>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <map>
+#include <string>
+#include <vector>
+
+#ifndef _WIN32
+#include <fcntl.h>
+#include <unistd.h>
+#endif
+
+extern "C" __attribute__((weak)) int ps5lm_rpc_park_write(int op, const char * path, const void * data, size_t size);
+
+namespace ggml_rpc_park {
+
+namespace pfs = std::filesystem;
+
+constexpr size_t PARK_BUF_SIZE = 8u << 20;
+
+// a checksum of a stream, the same however the stream is cut into pieces:
+// FNV-1a over 8-byte words (a byte at a time would cost seconds per GiB)
+struct hash64 {
+    uint64_t h = 0xcbf29ce484222325ULL;
+    uint64_t total = 0;
+    uint8_t  carry[8];
+    size_t   n = 0;
+
+    void word(uint64_t w) {
+        h = (h ^ w) * 0x100000001b3ULL;
+        h ^= h >> 29;
+    }
+    void add(const void * data, size_t len) {
+        const uint8_t * p = (const uint8_t *) data;
+        total += len;
+        while (n > 0 && n < 8 && len > 0) {
+            carry[n++] = *p++;
+            len--;
+        }
+        if (n == 8) {
+            uint64_t w;
+            memcpy(&w, carry, 8);
+            word(w);
+            n = 0;
+        }
+        while (len >= 8) {
+            uint64_t w;
+            memcpy(&w, p, 8);
+            word(w);
+            p += 8;
+            len -= 8;
+        }
+        while (len > 0) {
+            carry[n++] = *p++;
+            len--;
+        }
+    }
+    uint64_t done() const {
+        hash64 c = *this;
+        for (size_t i = 0; i < n; i++) {
+            c.word(carry[i]);
+        }
+        c.word(total);
+        return c.h;
+    }
+};
+
+// strnlen, which the PS5 SDK's libc does not have
+inline size_t bounded_len(const char * s, size_t max) {
+    size_t n = 0;
+    while (n < max && s[n] != '\0') {
+        n++;
+    }
+    return n;
+}
+
+// letters, digits, '.', '_' and '-', not starting with '.', shorter than the field
+inline bool name_ok(const char * s, size_t field, size_t max_len) {
+    const size_t n = bounded_len(s, field);
+    if (n == 0 || n >= field || n > max_len || s[0] == '.') {
+        return false;
+    }
+    for (size_t i = 0; i < n; i++) {
+        const char c = s[i];
+        const bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-';
+        if (!ok) {
+            return false;
+        }
+    }
+    return true;
+}
+
+inline int64_t unix_time(pfs::file_time_type t) {
+    const auto sys = std::chrono::time_point_cast<std::chrono::system_clock::duration>(
+        t - pfs::file_time_type::clock::now() + std::chrono::system_clock::now());
+    return std::chrono::duration_cast<std::chrono::seconds>(sys.time_since_epoch()).count();
+}
+
+struct key_info {
+    std::string name;
+    uint64_t    bytes   = 0;
+    uint32_t    n_files = 0;
+    int64_t     mtime   = 0;   // of the folder or its newest file: about when it was last saved
+    uint64_t    used    = 0;   // its place in the order of use (higher is later); 0: not in the record
+};
+
+struct file_info {
+    std::string name;
+    uint64_t    bytes = 0;
+    int64_t     mtime = 0;
+};
+
+class store {
+public:
+    store() {
+        const char * d = std::getenv("GGML_RPC_PARK_DIR");
+        if (d == nullptr || d[0] == '\0') {
+            return;
+        }
+        dir = d;
+        cap     = gib(std::getenv("GGML_RPC_PARK_GB"), 128.0);
+        // for tests: "rs:64" ends the process once 64 bytes of a .rs file are written
+        if (const char * die = std::getenv("GGML_RPC_PARK_DIE_AT")) {
+            const char * colon = std::strchr(die, ':');
+            if (colon != nullptr) {
+                die_ext = "." + std::string(die, colon - die);
+                die_at  = std::strtoull(colon + 1, nullptr, 10);
+            }
+        }
+        reserve = gib(std::getenv("GGML_RPC_PARK_RESERVE_GB"), 16.0);
+        std::error_code ec;
+        pfs::create_directories(dir, ec);
+        if (!pfs::is_directory(dir, ec)) {
+            dir.clear();
+            return;
+        }
+        // nothing is being written when a client connects: a .part file is what a
+        // crash or a dropped client left
+        for (pfs::directory_iterator kit(dir, ec), kend; !ec && kit != kend; kit.increment(ec)) {
+            std::error_code e;
+            if (!kit->is_directory(e)) {
+                continue;
+            }
+            for (pfs::directory_iterator fit(kit->path(), e), fend; !e && fit != fend; fit.increment(e)) {
+                if (fit->path().extension() == ".part") {
+                    std::error_code e2;
+                    pfs::remove(fit->path(), e2);
+                }
+            }
+        }
+        used_load();
+    }
+
+    ~store() {
+        write_abort();
+        read_close();
+    }
+
+    store(const store &)             = delete;
+    store & operator=(const store &) = delete;
+
+    bool enabled() const { return !dir.empty(); }
+
+    uint8_t * buffer() {
+        if (buf.empty()) {
+            buf.resize(PARK_BUF_SIZE);
+        }
+        return buf.data();
+    }
+
+    const std::string & error() const { return err; }
+
+    // ---- writing: one file at a time, from its start ----
+
+    int write_begin(const char * key, const char * file, uint64_t expect, uint32_t & n_pruned) {
+        n_pruned = 0;
+        if (!names_ok(key, file)) {
+            return fail(GGML_RPC_PARK_BAD, "invalid key or file name");
+        }
+        write_abort();
+        std::error_code ec;
+        const pfs::path kdir = pfs::path(dir) / key;
+        pfs::create_directories(kdir, ec);
+        if (ec) {
+            return fail(GGML_RPC_PARK_IO, "cannot create " + kdir.string() + ": " + ec.message());
+        }
+        const int st = prune(expect, key, n_pruned);
+        if (st != GGML_RPC_PARK_OK) {
+            return st;
+        }
+        w_final = (kdir / file).string();
+        w_part  = w_final + ".part";
+        pfs::remove(w_part, ec);
+        if (ps5lm_rpc_park_write) {
+            const int r = ps5lm_rpc_park_write(0, w_part.c_str(), nullptr, 0);
+            if (r != 1) {
+                return fail(r < 0 ? GGML_RPC_PARK_NO_WRITER : GGML_RPC_PARK_IO, "cannot begin " + w_part);
+            }
+        } else {
+            w_fp = std::fopen(w_part.c_str(), "wb");
+            if (w_fp == nullptr) {
+                return fail(errno == ENOSPC ? GGML_RPC_PARK_NO_SPACE : GGML_RPC_PARK_IO, "cannot create " + w_part + ": " + std::strerror(errno));
+            }
+            std::setvbuf(w_fp, nullptr, _IONBF, 0);
+        }
+        w_open  = true;
+        w_key   = key;
+        w_bytes = 0;
+        w_hash  = hash64();
+        return GGML_RPC_PARK_OK;
+    }
+
+    int write(const void * data, size_t n) {
+        if (!w_open) {
+            return fail(GGML_RPC_PARK_BAD, "no file is being written");
+        }
+        bool ok;
+        int  e = 0;
+        if (ps5lm_rpc_park_write) {
+            ok = ps5lm_rpc_park_write(1, w_part.c_str(), data, n) == 1;
+        } else {
+            ok = std::fwrite(data, 1, n, w_fp) == n;
+            e  = errno;
+        }
+        if (!ok) {
+            const std::string part = w_part;
+            write_abort();
+            return fail(e == ENOSPC ? GGML_RPC_PARK_NO_SPACE : GGML_RPC_PARK_IO, "write to " + part + " failed" + (e ? std::string(": ") + std::strerror(e) : ""));
+        }
+        w_hash.add(data, n);
+        w_bytes += n;
+        if (!die_ext.empty() && w_bytes >= die_at && pfs::path(w_final).extension() == die_ext) {
+            LOG_ERROR("[park] GGML_RPC_PARK_DIE_AT: stopping in the middle of %s\n", w_final.c_str());
+            std::_Exit(3);
+        }
+        return GGML_RPC_PARK_OK;
+    }
+
+    // the file takes its name only here, once every byte is in it
+    int write_commit(uint64_t & size, uint64_t & hash) {
+        if (!w_open) {
+            return fail(GGML_RPC_PARK_BAD, "no file is being written");
+        }
+        bool ok;
+        if (ps5lm_rpc_park_write) {
+            ok = ps5lm_rpc_park_write(2, w_part.c_str(), nullptr, 0) == 1;
+        } else {
+            ok = std::fflush(w_fp) == 0;
+#ifndef _WIN32
+            ok = ok && fsync(fileno(w_fp)) == 0;
+#endif
+            ok = std::fclose(w_fp) == 0 && ok;
+            w_fp = nullptr;
+        }
+        w_open = false;
+        std::error_code ec;
+        if (ok) {
+            const uintmax_t on_disk = pfs::file_size(w_part, ec);
+            ok = !ec && on_disk == w_bytes;
+        }
+        if (ok) {
+            pfs::rename(w_part, w_final, ec);
+            ok = !ec;
+        }
+        if (!ok) {
+            pfs::remove(w_part, ec);
+            w_key.clear();
+            return fail(GGML_RPC_PARK_IO, "could not finish " + w_final);
+        }
+        touch(w_key, false);
+        w_key.clear();
+        size = w_bytes;
+        hash = w_hash.done();
+        return GGML_RPC_PARK_OK;
+    }
+
+    void write_abort() {
+        if (!w_open) {
+            return;
+        }
+        if (ps5lm_rpc_park_write) {
+            ps5lm_rpc_park_write(3, w_part.c_str(), nullptr, 0);
+        } else if (w_fp != nullptr) {
+            std::fclose(w_fp);
+            w_fp = nullptr;
+        }
+        std::error_code ec;
+        pfs::remove(w_part, ec);
+        w_open = false;
+        w_key.clear();
+    }
+
+    // ---- reading: one file at a time, in order from an offset ----
+
+    int read_begin(const char * key, const char * file, uint64_t offset, uint64_t & size) {
+        if (!names_ok(key, file)) {
+            return fail(GGML_RPC_PARK_BAD, "invalid key or file name");
+        }
+        read_close();
+        const std::string path = (pfs::path(dir) / key / file).string();
+        std::error_code ec;
+        const uintmax_t on_disk = pfs::file_size(path, ec);
+        if (ec) {
+            return fail(GGML_RPC_PARK_NOT_FOUND, "no file " + path);
+        }
+        if (offset > on_disk) {
+            return fail(GGML_RPC_PARK_SHORT, path + " is shorter than the offset");
+        }
+        // Each read below is one read call of up to PARK_BUF_SIZE: a PS5 title's every read call takes about
+        // 1.4 ms. Not through a stream without a buffer: the console's libc then reads a byte per call, and a
+        // 150 MiB state would take days.
+#ifdef _WIN32
+        r_fp = std::fopen(path.c_str(), "rb");
+        const bool opened  = r_fp != nullptr;
+        const bool seek_ok = opened && (offset == 0 || _fseeki64(r_fp, (long long) offset, SEEK_SET) == 0);
+#else
+        r_fd = ::open(path.c_str(), O_RDONLY);
+        const bool opened  = r_fd >= 0;
+        const bool seek_ok = opened && (offset == 0 || ::lseek(r_fd, (off_t) offset, SEEK_SET) == (off_t) offset);
+#endif
+        if (!opened) {
+            return fail(GGML_RPC_PARK_NOT_FOUND, "cannot open " + path);
+        }
+        if (!seek_ok) {
+            read_close();
+            return fail(GGML_RPC_PARK_IO, "cannot seek in " + path);
+        }
+        r_key   = key;
+        r_path  = path;
+        r_bytes = 0;
+        r_hash  = hash64();
+        touch(r_key, true);
+        size = on_disk;
+        return GGML_RPC_PARK_OK;
+    }
+
+    int read(void * data, size_t n) {
+        if (!reading()) {
+            return fail(GGML_RPC_PARK_BAD, "no file is being read");
+        }
+        size_t got = 0;
+        bool   eof = false;
+#ifdef _WIN32
+        got = std::fread(data, 1, n, r_fp);
+        eof = std::feof(r_fp) != 0;
+#else
+        while (got < n) {
+            const ssize_t k = ::read(r_fd, (char *) data + got, n - got);
+            if (k < 0 && errno == EINTR) {
+                continue;
+            }
+            if (k <= 0) {
+                eof = k == 0;
+                break;
+            }
+            got += (size_t) k;
+        }
+#endif
+        if (got != n) {
+            return fail(eof ? GGML_RPC_PARK_SHORT : GGML_RPC_PARK_IO, r_path + (eof ? " ends early" : " could not be read"));
+        }
+        r_hash.add(data, n);
+        r_bytes += n;
+        return GGML_RPC_PARK_OK;
+    }
+
+    int read_end(uint64_t & bytes, uint64_t & hash) {
+        if (!reading()) {
+            return fail(GGML_RPC_PARK_BAD, "no file is being read");
+        }
+        bytes = r_bytes;
+        hash  = r_hash.done();
+        read_close();
+        return GGML_RPC_PARK_OK;
+    }
+
+    void read_close() {
+#ifdef _WIN32
+        if (r_fp != nullptr) {
+            std::fclose(r_fp);
+            r_fp = nullptr;
+        }
+#else
+        if (r_fd >= 0) {
+            ::close(r_fd);
+            r_fd = -1;
+        }
+#endif
+        r_key.clear();
+    }
+
+    // ---- keys ----
+
+    // a file of a key, or with no file name the whole key
+    int remove(const char * key, const char * file, uint64_t & freed, uint64_t & existed) {
+        freed   = 0;
+        existed = 0;
+        const bool whole = file[0] == '\0';
+        if (!name_ok(key, GGML_RPC_PARK_KEY_SIZE, GGML_RPC_PARK_KEY_SIZE - 1) ||
+            (!whole && !name_ok(file, GGML_RPC_PARK_FILE_SIZE, GGML_RPC_PARK_FILE_SIZE - 6))) {
+            return fail(GGML_RPC_PARK_BAD, "invalid key or file name");
+        }
+        std::error_code ec;
+        const pfs::path kdir = pfs::path(dir) / key;
+        if (whole) {
+            if (key == w_key || key == r_key) {
+                return fail(GGML_RPC_PARK_BAD, std::string("key ") + key + " has a file open");
+            }
+            for (const auto & f : files(key)) {
+                freed += f.bytes;
+            }
+            existed = pfs::exists(kdir, ec) ? 1 : 0;
+            pfs::remove_all(kdir, ec);
+            forget(key);
+            used_store();
+        } else {
+            const pfs::path path = kdir / file;
+            const uintmax_t n = pfs::file_size(path, ec);
+            if (!ec) {
+                existed = 1;
+                freed   = n;
+                pfs::remove(path, ec);
+            }
+        }
+        return GGML_RPC_PARK_OK;
+    }
+
+    std::vector<key_info> keys() const {
+        std::vector<key_info> out;
+        std::error_code ec;
+        for (pfs::directory_iterator kit(dir, ec), kend; !ec && kit != kend; kit.increment(ec)) {
+            std::error_code e;
+            if (!kit->is_directory(e)) {
+                continue;
+            }
+            key_info k;
+            k.name = kit->path().filename().string();
+            if (!name_ok(k.name.c_str(), GGML_RPC_PARK_KEY_SIZE, GGML_RPC_PARK_KEY_SIZE - 1)) {
+                continue;
+            }
+            const auto dt = pfs::last_write_time(kit->path(), e);
+            k.mtime = e ? 0 : unix_time(dt);
+            const auto u = used.find(k.name);
+            k.used = u == used.end() ? 0 : u->second;
+            for (const auto & f : files(k.name)) {
+                k.bytes += f.bytes;
+                k.n_files++;
+                k.mtime = std::max(k.mtime, f.mtime);
+            }
+            out.push_back(std::move(k));
+        }
+        std::sort(out.begin(), out.end(), [](const key_info & a, const key_info & b) { return a.name < b.name; });
+        return out;
+    }
+
+    // whole files only: one still being written has no name yet
+    std::vector<file_info> files(const std::string & key) const {
+        std::vector<file_info> out;
+        std::error_code ec;
+        for (pfs::directory_iterator fit(pfs::path(dir) / key, ec), fend; !ec && fit != fend; fit.increment(ec)) {
+            std::error_code e;
+            if (!fit->is_regular_file(e) || fit->path().extension() == ".part") {
+                continue;
+            }
+            file_info f;
+            f.name  = fit->path().filename().string();
+            f.bytes = fit->file_size(e);
+            if (e) {
+                continue;
+            }
+            const auto ft = fit->last_write_time(e);
+            f.mtime = e ? 0 : unix_time(ft);
+            out.push_back(std::move(f));
+        }
+        std::sort(out.begin(), out.end(), [](const file_info & a, const file_info & b) { return a.name < b.name; });
+        return out;
+    }
+
+    void stat(uint64_t & free_bytes, uint64_t & used, uint64_t & cap_bytes, uint64_t & n_keys) const {
+        used = 0;
+        const auto all = keys();
+        for (const auto & k : all) {
+            used += k.bytes;
+        }
+        n_keys     = all.size();
+        cap_bytes  = cap;
+        free_bytes = disk_free();
+    }
+
+    // room for `need` more bytes: under the cap and with the reserve left free on
+    // the disk, dropping the keys used longest ago, never `keep` or one with a file open
+    int prune(uint64_t need, const std::string & keep, uint32_t & n_pruned) {
+        auto all = keys();
+        uint64_t used = 0;
+        for (const auto & k : all) {
+            used += k.bytes;
+        }
+        uint64_t free_bytes = disk_free();
+        // by the record of use; keys it does not know (parked by a build without it) come first, by their file times
+        std::sort(all.begin(), all.end(), [](const key_info & a, const key_info & b) {
+            return a.used != b.used ? a.used < b.used : a.mtime < b.mtime;
+        });
+        const auto enough = [&]() {
+            return used + need <= cap && (free_bytes == UINT64_MAX || free_bytes >= need + reserve);
+        };
+        for (const auto & k : all) {
+            if (enough()) {
+                break;
+            }
+            if (k.name == keep || k.name == w_key || k.name == r_key || k.name == last_restored) {
+                continue;
+            }
+            std::error_code ec;
+            pfs::remove_all(pfs::path(dir) / k.name, ec);
+            forget(k.name);
+            LOG_INFO("[park] dropped key '%s' (%.1f MiB, least recently used) to make room\n", k.name.c_str(), k.bytes / 1048576.0);
+            used -= std::min(used, k.bytes);
+            if (free_bytes != UINT64_MAX) {
+                free_bytes += k.bytes;
+            }
+            n_pruned++;
+        }
+        if (n_pruned > 0) {
+            used_store();
+        }
+        if (!enough()) {
+            char text[160];
+            snprintf(text, sizeof(text), "no room for %.1f MiB: %.1f MiB used of %.1f MiB, %.1f MiB free on the disk",
+                     need / 1048576.0, used / 1048576.0, cap / 1048576.0, free_bytes == UINT64_MAX ? -1.0 : free_bytes / 1048576.0);
+            return fail(GGML_RPC_PARK_NO_SPACE, text);
+        }
+        return GGML_RPC_PARK_OK;
+    }
+
+private:
+    static uint64_t gib(const char * text, double fallback) {
+        double v = fallback;
+        if (text != nullptr && text[0] != '\0') {
+            char * end = nullptr;
+            const double parsed = std::strtod(text, &end);
+            if (end != text && parsed >= 0) {
+                v = parsed;
+            }
+        }
+        return (uint64_t) (v * 1024.0 * 1024.0 * 1024.0);
+    }
+
+    static bool names_ok(const char * key, const char * file) {
+        // a file name leaves room for ".part"
+        return name_ok(key, GGML_RPC_PARK_KEY_SIZE, GGML_RPC_PARK_KEY_SIZE - 1) &&
+               name_ok(file, GGML_RPC_PARK_FILE_SIZE, GGML_RPC_PARK_FILE_SIZE - 6) &&
+               pfs::path(file).extension() != ".part";
+    }
+
+    // UINT64_MAX when the system does not say
+    uint64_t disk_free() const {
+        std::error_code ec;
+        const auto sp = pfs::space(dir, ec);
+        // a PS5 title's statvfs is a stub that answers zeros: unknown, like an error
+        return ec || sp.capacity == 0 || sp.available == (uintmax_t) -1 ? UINT64_MAX : (uint64_t) sp.available;
+    }
+
+    // ---- the order the keys were used in, for prune() ----
+
+    // a key was saved or restored just now
+    void touch(const std::string & key, bool restored) {
+        used[key] = ++used_clock;
+        if (restored) {
+            last_restored = key;
+        }
+        used_store();
+    }
+
+    void forget(const std::string & key) {
+        used.erase(key);
+        if (last_restored == key) {
+            last_restored.clear();
+        }
+    }
+
+    // .used: a line "<place> <key>" per key, and "R <key>" for the one restored last
+    void used_load() {
+        FILE * f = std::fopen((pfs::path(dir) / ".used").string().c_str(), "rb");
+        if (f == nullptr) {
+            return;
+        }
+        char line[GGML_RPC_PARK_KEY_SIZE + 40];
+        while (std::fgets(line, sizeof(line), f) != nullptr) {
+            std::string text(line);
+            while (!text.empty() && (text.back() == '\n' || text.back() == '\r')) {
+                text.pop_back();
+            }
+            const size_t space = text.find(' ');
+            if (space == std::string::npos) {
+                continue;
+            }
+            const std::string key = text.substr(space + 1);
+            std::error_code ec;
+            if (!name_ok(key.c_str(), GGML_RPC_PARK_KEY_SIZE, GGML_RPC_PARK_KEY_SIZE - 1) || !pfs::is_directory(pfs::path(dir) / key, ec)) {
+                continue;   // a key that is gone
+            }
+            if (text[0] == 'R') {
+                last_restored = key;
+            } else {
+                const uint64_t place = std::strtoull(text.c_str(), nullptr, 10);
+                used[key]  = place;
+                used_clock = std::max(used_clock, place);
+            }
+        }
+        std::fclose(f);
+    }
+
+    // Written whole under another name and renamed, through the title's writer where there is one. While a
+    // parked file is being written the writer is taken: the record goes out with the next change then, and
+    // until it does only this process knows the order (a worker restarted in between falls back to file times
+    // for what it missed).
+    void used_store() {
+        if (w_open) {
+            return;
+        }
+        std::string text;
+        for (const auto & [key, place] : used) {
+            text += std::to_string(place) + " " + key + "\n";
+        }
+        if (!last_restored.empty()) {
+            text += "R " + last_restored + "\n";
+        }
+        const std::string whole = (pfs::path(dir) / ".used").string();
+        const std::string part  = whole + ".part";
+        bool ok;
+        if (ps5lm_rpc_park_write) {
+            ok = ps5lm_rpc_park_write(0, part.c_str(), nullptr, 0) == 1 &&
+                 (text.empty() || ps5lm_rpc_park_write(1, part.c_str(), text.data(), text.size()) == 1) &&
+                 ps5lm_rpc_park_write(2, part.c_str(), nullptr, 0) == 1;
+        } else {
+            FILE * f = std::fopen(part.c_str(), "wb");
+            ok = f != nullptr && std::fwrite(text.data(), 1, text.size(), f) == text.size();
+            ok = f != nullptr && std::fclose(f) == 0 && ok;
+        }
+        std::error_code ec;
+        if (ok) {
+            pfs::rename(part, whole, ec);
+        }
+        if (!ok || ec) {
+            pfs::remove(part, ec);
+            LOG_ERROR("[park] could not write %s: the order of use is kept in memory only\n", whole.c_str());
+        }
+    }
+
+    int fail(int status, const std::string & text) {
+        err = text;
+        if (status != GGML_RPC_PARK_NOT_FOUND) {
+            LOG_ERROR("[park] %s\n", text.c_str());
+        }
+        return status;
+    }
+
+    std::string dir;
+    uint64_t    cap     = 0;
+    uint64_t    reserve = 0;
+    std::string err;
+    std::vector<uint8_t> buf;
+    std::map<std::string, uint64_t> used;   // key -> its place in the order of use
+    uint64_t    used_clock = 0;
+    std::string last_restored;
+    std::string die_ext;
+    uint64_t    die_at  = 0;
+
+    bool        w_open  = false;
+    FILE *      w_fp    = nullptr;
+    std::string w_key, w_part, w_final;
+    uint64_t    w_bytes = 0;
+    hash64      w_hash;
+
+    FILE *      r_fp    = nullptr;   // Windows
+    int         r_fd    = -1;        // elsewhere
+    bool reading() const { return r_fp != nullptr || r_fd >= 0; }
+    std::string r_key, r_path;
+    uint64_t    r_bytes = 0;
+    hash64      r_hash;
+};
+
+} // namespace ggml_rpc_park
