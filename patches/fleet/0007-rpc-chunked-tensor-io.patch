         size_t offset, size_t size, size_t n_copies, size_t stride_tensor, size_t stride_data) {
+    if (const size_t chunk = rpc_chunk_bytes(); chunk && size*n_copies > chunk && n_copies > 1) {
+        const size_t per = std::max<size_t>(1, chunk/size);
+        for (size_t i = 0; i < n_copies; i += per) {
+            ggml_backend_rpc_buffer_get_tensor_2d(buffer, tensor, (char *) data + i*stride_data, offset + i*stride_tensor,
+                    size, std::min(per, n_copies - i), stride_tensor, stride_data);
+        }
+        return;
+    }
     ggml_backend_rpc_buffer_context * ctx = (ggml_backend_rpc_buffer_context *)buffer->context;
     LOG_DBG2("[%s] tensor: %s, offset: %zu, size: %s, n_copies: %zu, stride: %zu\n", __func__,
              rpc_log_format_tensor(tensor).c_str(), offset, rpc_log_format_size(size).c_str(), n_copies, stride_tensor);
@@ -948,6 +984,12 @@ static void ggml_backend_rpc_buffer_get_tensor_2d(ggml_backend_buffer_t buffer,
 }
 
 static void ggml_backend_rpc_buffer_get_tensor(ggml_backend_buffer_t buffer, const ggml_tensor * tensor, void * data, size_t offset, size_t size) {
+    if (const size_t chunk = rpc_chunk_bytes(); chunk && size > chunk) {
