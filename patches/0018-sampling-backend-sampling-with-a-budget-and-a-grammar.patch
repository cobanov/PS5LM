 }
 
+// PS5LM fork: backend sampling with host checks (see sampling.h)
+
+struct llama_sampler * common_sampler_get_backend(const struct common_sampler * gsmpl) {
+    if (!gsmpl) {
+        return nullptr;
+    }
+
+    return gsmpl->dev ? gsmpl->dev : gsmpl->chain;
+}
+
+bool common_sampler_backend_checks(const struct common_sampler * gsmpl) {
+    return gsmpl != nullptr && gsmpl->dev != nullptr;
+}
+
+common_sampler_backend_stats common_sampler_backend_stats_get(const struct common_sampler * gsmpl) {
+    return gsmpl ? gsmpl->dev_stats : common_sampler_backend_stats();
+}
+
+static bool grammar_should_apply(struct common_sampler * gsmpl);
+
+// common_sampler_sample() for a sampler with host checks. Every branch gives the token common_sampler_sample()
+// gives on the full logits, and leaves the samplers (the random number generators too) in the same state.
+static llama_token common_sampler_sample_checked(struct common_sampler * gsmpl, struct llama_context * ctx, int idx, bool grammar_first) {
+    llama_token id = LLAMA_TOKEN_NULL;
+
+    auto & grmr    = gsmpl->grmr;
+    auto & rbudget = gsmpl->rbudget;
+    auto & chain   = gsmpl->chain;
+    auto & cur_p   = gsmpl->cur_p;
+    auto & stats   = gsmpl->dev_stats;
+
+    // the budget forces a token: every other logit of the full vocabulary becomes -inf
+    const bool forcing = rbudget && common_reasoning_budget_get_state(rbudget) == REASONING_BUDGET_FORCING;
+
+    // the grammar constrains this token (a lazy grammar that waits for its trigger accepts everything)
+    const bool grmr_on = grammar_should_apply(gsmpl) && !llama_sampler_grammar_is_idle(grmr);
+
+    bool tie = false;
+
+    if (forcing) {
+        stats.n_host_forced++;
+    } else if (grammar_first && grmr_on) {
+        stats.n_host_grammar++;
+    } else if (!gsmpl->set_candidates(ctx, idx, tie)) {
+        if (tie) {
+            stats.n_host_tie++;
+        } else {
+            stats.n_host_other++;
+        }
+    } else {
+        // verify: a copy of the chain as it is now, the random number generators too
+        llama_sampler * chain_ref = gsmpl->dev_verify ? llama_sampler_clone(chain) : nullptr;
+
+        // neither the budget nor (before the chain) the grammar changes a logit here, and the chain's first
+        // active sampler is its top-k, which keeps of these top_k + 1 candidates what it keeps of the vocabulary
+        llama_sampler_apply(chain, &cur_p);
+
+        id = cur_p.data[cur_p.selected].id;
+
+        if (chain_ref) {
+            // the first choice of common_sampler_sample() on the full logits
+            const llama_token_data_array cur_p_keep = cur_p;
+            gsmpl->dev_keep = gsmpl->cur;
+
+            gsmpl->set_logits_full(ctx, idx);
+
+            llama_sampler_apply(rbudget, &cur_p);
+            llama_sampler_apply(chain_ref, &cur_p);
+
+            const llama_token id_ref = cur_p.selected >= 0 ? cur_p.data[cur_p.selected].id : LLAMA_TOKEN_NULL;
+
+            llama_sampler_free(chain_ref);
+
+            gsmpl->cur = gsmpl->dev_keep;
+            cur_p      = { gsmpl->cur.data(), cur_p_keep.size, cur_p_keep.selected, cur_p_keep.sorted };
+
+            stats.n_verified++;
+            if (id_ref != id) {
+                stats.n_differed++;
+                LOG_ERR("%s: backend sampling with host checks: token %d from the backend's candidates, %d from the full logits\n",
+                        __func__, id, id_ref);
+            }
+        }
+
+        if (!grmr_on) {
+            stats.n_backend++;
+            return id;
+        }
+
+        // check if it the sampled token fits the grammar (grammar-based rejection sampling)
+        {
+            llama_token_data       single_token_data       = { id, 1.0f, 0.0f };
+            llama_token_data_array single_token_data_array = { &single_token_data, 1, -1, false };
+
+            llama_sampler_apply(grmr, &single_token_data_array);
+
+            const bool is_valid = single_token_data_array.data[0].logit != -INFINITY;
+            if (is_valid) {
+                stats.n_backend++;
+                return id;
+            }
+        }
+
+        // resampling, as in common_sampler_sample(), with the full logits
+        stats.n_host++;
+        stats.n_host_grammar++;
+
+        gsmpl->set_logits_full(ctx, idx);
+
+        llama_sampler_apply(rbudget, &cur_p);
+
+        if (grammar_should_apply(gsmpl)) {
+            llama_sampler_apply(grmr, &cur_p);
+        }
+
+        llama_sampler_apply(chain, &cur_p);
+
+        GGML_ASSERT(cur_p.selected != -1 && "no selected token during sampling - check your sampling configuration");
+
+        return cur_p.data[cur_p.selected].id;
+    }
+
+    // common_sampler_sample() as it is, with the full logits
+    stats.n_host++;
+
+    gsmpl->set_logits_full(ctx, idx);
+
+    llama_sampler_apply(rbudget, &cur_p);
+
+    if (grammar_first && grammar_should_apply(gsmpl)) {
+        llama_sampler_apply(grmr, &cur_p);
+    }
+
+    llama_sampler_apply(chain, &cur_p);
+
+    id = cur_p.data[cur_p.selected].id;
+
+    if (grammar_first || !grammar_should_apply(gsmpl)) {
+        return id;
+    }
+
+    {
+        llama_token_data       single_token_data       = { id, 1.0f, 0.0f };
+        llama_token_data_array single_token_data_array = { &single_token_data, 1, -1, false };
+
+        llama_sampler_apply(grmr, &single_token_data_array);
+
+        const bool is_valid = single_token_data_array.data[0].logit != -INFINITY;
+        if (is_valid) {
+            return id;
+        }
+    }
+
+    gsmpl->set_logits_full(ctx, idx);
+
+    llama_sampler_apply(rbudget,  &cur_p);
+
+    if (grammar_should_apply(gsmpl)) {
+        llama_sampler_apply(grmr,  &cur_p);
+    }
+
+    llama_sampler_apply(chain, &cur_p);
+
+    GGML_ASSERT(cur_p.selected != -1 && "no selected token during sampling - check your sampling configuration");
+
+    return cur_p.data[cur_p.selected].id;
+}
+
 llama_token common_sampler_sample(struct common_sampler * gsmpl, struct llama_context * ctx, int idx, bool grammar_first) {
     llama_synchronize(ctx);
 
