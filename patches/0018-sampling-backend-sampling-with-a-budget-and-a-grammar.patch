+// PS5LM fork: backend sampling with host checks
+//
+// A grammar and a reasoning budget run on the host, so with them the whole chain used to move to the host and
+// every token cost a download of the full vocabulary. With host checks the backend keeps one job, the top-k:
+// it returns the top_k + 1 best candidates, and the host runs its unchanged chain on those. That gives the same
+// token as the chain on the full vocabulary whenever the top_k + 1 logits differ from each other. The full
+// logits are fetched (llama_get_logits_on_demand_ith) only for a step that needs them: a token the reasoning
+// budget forces, a token the grammar rejects, and equal logits among the candidates. Those steps run the host
+// algorithm as it was.
+//
+// LLAMA_BACKEND_SAMPLING_CHECKS in the environment: "0" turns it off; "verify" also chooses every token on the
+// full logits with a copy of the chain, counts the tokens that differ and logs each (for testing: it fetches the
+// full logits for every token).
+//
+// the sampler to attach with llama_set_sampler(): the top-k chain with host checks, else the whole chain
+struct llama_sampler * common_sampler_get_backend(const struct common_sampler * gsmpl);
+
+// true when the sampler was set up for host checks; the caller then also asks for
+// llama_set_logits_on_demand() on the sequence
+bool common_sampler_backend_checks(const struct common_sampler * gsmpl);
+
+struct common_sampler_backend_stats {
+    int32_t n_backend      = 0; // tokens chosen from the backend's candidates
+    int32_t n_host         = 0; // tokens that needed the full logits
+    int32_t n_host_forced  = 0; //   forced by the reasoning budget
+    int32_t n_host_grammar = 0; //   rejected by the grammar, or grammar-first sampling
+    int32_t n_host_tie     = 0; //   equal logits among the candidates
+    int32_t n_host_other   = 0; //   no candidates from the backend
+
+    // LLAMA_BACKEND_SAMPLING_CHECKS=verify: tokens from the backend's candidates that were also chosen on the
+    // full logits (fetched for that alone, so it costs what host sampling costs), and how many differed
+    int32_t n_verified     = 0;
+    int32_t n_differed     = 0;
+};
+
+common_sampler_backend_stats common_sampler_backend_stats_get(const struct common_sampler * gsmpl);
+
 // extended sampling implementation:
 //
 // - set logits
