     }
 
     mutable int64_t t_total_us = 0;
+
+    // PS5LM fork: backend sampling with host checks (see sampling.h)
+    struct llama_sampler * dev = nullptr; // what the backend runs: top-k (dev_k)
+    int32_t dev_k = 0;                    // top_k + 1
+
+    common_sampler_backend_stats dev_stats;
+
+    std::vector<float> dev_sorted;
+
+    bool dev_verify = false;              // LLAMA_BACKEND_SAMPLING_CHECKS=verify
+    std::vector<llama_token_data> dev_keep;
+
+    // the backend's candidates for this row; false when there are none or they cannot be used
+    bool set_candidates(struct llama_context * ctx, int idx, bool & tie) {
+        tie = false;
+
+        const float *       logits = llama_get_sampled_logits_ith    (ctx, idx);
+        const llama_token * ids    = llama_get_sampled_candidates_ith(ctx, idx);
+
+        if (logits == nullptr || ids == nullptr ||
+                (int32_t) llama_get_sampled_logits_count_ith    (ctx, idx) != dev_k ||
+                (int32_t) llama_get_sampled_candidates_count_ith(ctx, idx) != dev_k) {
+            return false;
+        }
+
+        // the top-k of the full vocabulary is these candidates' top-k, in the same order, only if no two of
+        // them are equal: with equal logits the order (and at the edge the set) is the sort's choice
+        dev_sorted.assign(logits, logits + dev_k);
+        std::sort(dev_sorted.begin(), dev_sorted.end());
+        for (int32_t i = 0; i < dev_k; ++i) {
+            if (!std::isfinite(dev_sorted[i]) || (i > 0 && dev_sorted[i] == dev_sorted[i - 1])) {
+                tie = true;
+                return false;
+            }
+        }
+
+        cur.resize(dev_k);
+        for (int32_t i = 0; i < dev_k; ++i) {
+            cur[i] = llama_token_data{ids[i], logits[i], 0.0f};
+        }
+
+        cur_p = { cur.data(), cur.size(), -1, false };
+
+        return true;
+    }
+
+    // the full logits of this row, fetched from the backend if they are not on the host
+    void set_logits_full(struct llama_context * ctx, int idx) {
+        const float * logits = llama_get_logits_on_demand_ith(ctx, idx);
+        GGML_ASSERT(logits != nullptr && "backend sampling with host checks: the full logits of this row are not available");
+
+        const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx)));
+
+        cur.resize(n_vocab);
+        for (llama_token token_id = 0; token_id < n_vocab; token_id++) {
+            cur[token_id] = llama_token_data{token_id, logits[token_id], 0.0f};
+        }
+
+        cur_p = { cur.data(), cur.size(), -1, false };
+    }
 };
 
