+void llama_kv_cache::init_attn_rot_dev() {
+    if (hparams.no_alloc || (!n_rot_k && !n_rot_v) || layers.empty()) {
+        return;
+    }
+
+    ggml_backend_buffer_type_t buft = nullptr;
+    for (const auto & layer : layers) {
+        for (const ggml_tensor * t : { layer.k, layer.v }) {
+            if (!t) {
+                continue;
+            }
+            if (!t->buffer) {
+                return;
+            }
+            ggml_backend_buffer_type_t layer_buft = ggml_backend_buffer_get_type(t->buffer);
+            if (buft && layer_buft != buft) {
+                return; // split over devices: keep the matrices as graph inputs
+            }
+            buft = layer_buft;
+        }
+    }
+    if (!buft || ggml_backend_buft_is_host(buft)) {
+        return;
+    }
+
+    ggml_init_params params = {
+        /*.mem_size   =*/ 2*ggml_tensor_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx { ggml_init(params) };
+    if (!ctx) {
+        return;
+    }
+
+    ggml_tensor * k_rot = nullptr;
+    ggml_tensor * v_rot = nullptr;
+    if (n_rot_k) {
+        k_rot = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, n_rot_k, n_rot_k);
+        ggml_set_name(k_rot, "attn_k_rot_dev");
+    }
+    if (n_rot_v) {
+        v_rot = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, n_rot_v, n_rot_v);
+        ggml_set_name(v_rot, "attn_v_rot_dev");
+    }
+
+    ggml_backend_buffer_ptr buf { ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft) };
+    if (!buf) {
+        LLAMA_LOG_WARN("%s: could not allocate the rotation matrices on %s; uploading them per graph\n",
+                __func__, ggml_backend_buft_name(buft));
+        return;
+    }
+    ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    if (k_rot) {
+        ggml_backend_tensor_set(k_rot, attn_rot_hadamard.at(n_rot_k).data(), 0, ggml_nbytes(k_rot));
+    }
+    if (v_rot) {
+        ggml_backend_tensor_set(v_rot, attn_rot_hadamard.at(n_rot_v).data(), 0, ggml_nbytes(v_rot));
+    }
+
+    LLAMA_LOG_INFO("%s: rotation matrices kept on %s (%.2f KiB)\n", __func__,
+            ggml_backend_buffer_name(buf.get()), ggml_backend_buffer_get_size(buf.get())/1024.0);
+
+    attn_rot_k_dev = k_rot;
+    attn_rot_v_dev = v_rot;
+    attn_rot_ctx   = std::move(ctx);
+    attn_rot_buf   = std::move(buf);
+}
