+// PS5LM: keep the previous reply as it was generated.
+//
+// A chat client sends the previous reply back as a message. The chat template writes that message out again and the
+// text is tokenised again, and the result is not always the tokens the model generated: the same text can be spelled
+// with other tokens (" book" + "marks" generated, " bookmarks" on the way back), and the template trims the reasoning,
+// so whitespace the model wrote just before the end-of-reasoning marker is gone. The prompt cache then stops matching
+// inside the reply. A model with recurrent state cannot go back a few tokens, so the slot falls back to a context
+// checkpoint and reads the whole reply again - or, resumed from a parked save, the whole last firing.
+//
+// Tokens are compared as what they say: marker tokens (control and user-defined) by id and in order, and the bytes
+// of text between them. Whitespace right before an end-of-reasoning marker is not compared (the template drops it,
+// so no client can send it back).
+struct reply_unit {
+    llama_token marker; // the marker this text follows, LLAMA_TOKEN_NULL for the first unit
+    std::string text;   // without the whitespace before an end-of-reasoning marker
+    bool operator==(const reply_unit & o) const { return marker == o.marker && text == o.text; }
+};
+
+struct reply_place {    // where a token boundary is, in units and bytes
+    size_t unit;
+    size_t byte;
+    bool operator<(const reply_place & o) const { return unit != o.unit ? unit < o.unit : byte < o.byte; }
+    bool operator==(const reply_place & o) const { return unit == o.unit && byte == o.byte; }
+};
+
+// units: what toks[from..) say; after[k]: the boundary after token from + k
+static void reply_read(const llama_vocab * vocab, const llama_tokens & toks, size_t from, const std::vector<llama_tokens> & reasoning_ends,
+                       std::vector<reply_unit> & units, std::vector<reply_place> * after) {
+    units.push_back({LLAMA_TOKEN_NULL, ""});
+    for (size_t i = from; i < toks.size(); i++) {
+        const llama_token t = toks[i];
+        if (t == LLAMA_TOKEN_NULL) {
+            break; // a media chunk: nothing past it is compared
+        }
+        if (llama_vocab_get_attr(vocab, t) & (LLAMA_TOKEN_ATTR_CONTROL | LLAMA_TOKEN_ATTR_USER_DEFINED)) {
+            for (const auto & e : reasoning_ends) {
+                if (e.size() == 1 && e[0] == t) {
+                    auto & text = units.back().text;
+                    while (!text.empty() && std::isspace((unsigned char) text.back())) {
+                        text.pop_back();
+                    }
+                }
+            }
+            units.push_back({t, ""});
+        } else {
+            units.back().text += common_token_to_piece(vocab, t, false);
+        }
+        if (after != nullptr) {
+            // a boundary inside whitespace that is dropped afterwards keeps its place past the end of what is
+            // left: it is never taken on its own (only the text that is left counts towards how far two token
+            // lists agree), so dropped whitespace is only ever passed together with the marker it stood before
+            after->push_back({units.size() - 1, units.back().text.size()});
+        }
+    }
+}
+
+// cached[n_past..) is what the slot holds past the common prefix, next[n_past..) what the new prompt has there.
+// This finds how far the two go on saying the same: the furthest pair of token boundaries, one in each, up to
+// which they are the same units. Returns false when that is no further than n_past.
+//
+// The slot's tokens up to n_cached then stand for the prompt's up to n_next. It need not be the whole of either:
+// a later message that was really changed, a reply that was cut off or cancelled, and every request after a reply
+// was kept (each renders that reply again) all stop somewhere, and the rest is the usual path's.
+static bool reply_as_generated(const llama_vocab * vocab, const llama_tokens & cached, const llama_tokens & next,
+                               size_t n_past, const std::vector<llama_tokens> & reasoning_ends,
+                               size_t & n_cached, size_t & n_next) {
+    std::vector<reply_unit>  ua;
+    std::vector<reply_unit>  ub;
+    std::vector<reply_place> pa;
+    std::vector<reply_place> pb;
+    reply_read(vocab, cached, n_past, reasoning_ends, ua, &pa);
+    reply_read(vocab, next,   n_past, reasoning_ends, ub, &pb);
+
+    // how far the two say the same
+    reply_place limit = {0, 0};
+    for (size_t u = 0; u < ua.size() && u < ub.size(); u++) {
+        if (u > 0 && ua[u].marker != ub[u].marker) {
+            break;
+        }
+        const std::string & ta = ua[u].text;
+        const std::string & tb = ub[u].text;
+        size_t n = 0;
+        while (n < ta.size() && n < tb.size() && ta[n] == tb[n]) {
+            n++;
+        }
+        limit = {u, n};
+        if (n < ta.size() || n < tb.size()) {
+            break;
+        }
+    }
+
+    // the furthest boundary both have within that
+    size_t ia = pa.size();
+    size_t ib = pb.size();
+    while (ia > 0 && ib > 0) {
+        const reply_place & a = pa[ia - 1];
+        const reply_place & b = pb[ib - 1];
+        if (limit < a) {
+            ia--;
+        } else if (limit < b) {
+            ib--;
+        } else if (a == b) {
+            break;
+        } else if (b < a) {
+            ia--;
+        } else {
+            ib--;
+        }
+    }
+    if (ia == 0 || ib == 0) {
+        return false;
+    }
+    n_cached = n_past + ia;
+    n_next   = n_past + ib;
+    return true;
+}
+
+// whether two token lists say the same from a token on
+static bool reply_says_the_same(const llama_vocab * vocab, const llama_tokens & a, const llama_tokens & b, size_t from,
+                                const std::vector<llama_tokens> & reasoning_ends) {
+    std::vector<reply_unit> ua;
+    std::vector<reply_unit> ub;
+    reply_read(vocab, a, from, reasoning_ends, ua, nullptr);
+    reply_read(vocab, b, from, reasoning_ends, ub, nullptr);
+    return ua == ub;
+}
+
+// LLAMA_REPLY_AS_GENERATED=0 turns it off (to compare)
+static bool reply_as_generated_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("LLAMA_REPLY_AS_GENERATED");
+        return !(e != nullptr && e[0] == '0');
+    }();
+    return enabled;
+}
+
 // a checkpoint restore dropped tokens the target had accepted - re-accept them rather than verify again
 static std::vector<llama_token> server_accept_replay(
         common_sampler * smpl,
@@ -2111,6 +2248,47 @@
         // the per-request limit takes priority over the global one
         slot.n_predict_max = task.params.n_predict != -1 ? task.params.n_predict : params_base.n_predict;
 
+        // PS5LM: where the slot's tokens stop matching the prompt but go on saying the same (a reply the client
+        // sent back, see reply_as_generated() above), the prompt takes the slot's tokens for that stretch. Done
+        // here, while the task can still be changed; the prompt then shares that much more with the slot.
+        if (reply_as_generated_enabled() && task.type == SERVER_TASK_TYPE_COMPLETION && task.params.cache_prompt &&
+                !task.is_stateless() && !task.is_child() && task.n_tokens_shared <= 0 && slot.alora_invocation_start <= 0 &&
+                !slot.prompt.tokens.has_mtmd && !task.tokens.has_mtmd) {
+            const size_t n_past = slot.prompt.tokens.get_common_prefix(task.tokens);
+            if (n_past > 0 && n_past < slot.prompt.tokens.size() && n_past < task.tokens.size()) {
+                const llama_vocab * vocab = llama_model_get_vocab(model_tgt);
+                const auto & ends = task.params.sampling.reasoning_budget_end;
+                const llama_tokens cached = slot.prompt.tokens.get_text_tokens();
+                const llama_tokens next   = task.tokens.get_text_tokens();
+                size_t n_cached = 0;
+                size_t n_next   = 0;
+                if (reply_as_generated(vocab, cached, next, n_past, ends, n_cached, n_next) &&
+                        n_cached + next.size() - n_next < (size_t) slot.n_ctx) {
+                    llama_tokens merged(cached.begin(), cached.begin() + n_cached);
+                    merged.insert(merged.end(), next.begin() + n_next, next.end());
+
+                    // the prompt built here must say what the prompt that came in says, or it is not used
+                    if (!reply_says_the_same(vocab, merged, next, n_past, ends)) {
+                        SLT_WRN(slot, "previous reply not kept: with the slot's tokens to %zu the prompt would not say the same (it differs at %zu)\n",
+                                n_cached, n_past);
+                    } else {
+                        // the message spans after that stretch move with it
+                        const int64_t shift = (int64_t) n_cached - (int64_t) n_next;
+                        for (auto & span : task.params.message_spans.spans) {
+                            if (span.pos >= n_next) {
+                                span.pos = (size_t) ((int64_t) span.pos + shift);
+                            }
+                        }
+
+                        SLT_INF(slot, "previous reply kept as generated: the prompt differs at %zu, %zu cached tokens stand for its %zu re-rendered ones%s\n",
+                                n_past, n_cached - n_past, n_next - n_past, n_cached < cached.size() ? ", then it differs again" : "");
+
+                        task.tokens = server_tokens(merged, false);
+                    }
+                }
+            }
+        }
+
         slot.task = std::make_unique<const server_task>(std::move(task));
 
         if (slot.task->type == SERVER_TASK_TYPE_TTS) {
