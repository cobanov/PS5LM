+        // PS5LM: when the slot's tokens stop matching the prompt inside a reply the client sent back, and the
+        // two say the same, the prompt takes the slot's tokens for that reply (reply_as_generated() above). Done
+        // here, while the task can still be changed; the prompt is then an ordinary continuation of the slot.
+        if (reply_as_generated_enabled() && task.type == SERVER_TASK_TYPE_COMPLETION && task.params.cache_prompt &&
+                !task.is_stateless() && !task.is_child() && task.n_tokens_shared <= 0 && slot.alora_invocation_start <= 0 &&
+                !slot.prompt.tokens.has_mtmd && !task.tokens.has_mtmd) {
+            const size_t n_past = slot.prompt.tokens.get_common_prefix(task.tokens);
+            if (n_past > 0 && n_past < slot.prompt.tokens.size()) {
+                const llama_tokens cached = slot.prompt.tokens.get_text_tokens();
+                const llama_tokens next   = task.tokens.get_text_tokens();
+                const int32_t n_same = reply_as_generated(llama_model_get_vocab(model_tgt), cached, next, n_past,
+                                                          task.params.sampling.reasoning_budget_end);
+                if (n_same >= 0 && cached.size() + next.size() - n_past - n_same < (size_t) slot.n_ctx) {
+                    llama_tokens merged = cached;
+                    merged.insert(merged.end(), next.begin() + n_past + n_same, next.end());
+
+                    // the message spans after the reply move with it
+                    const size_t  pos_after = n_past + n_same;
+                    const int64_t shift     = (int64_t) cached.size() - (int64_t) pos_after;
+                    for (auto & span : task.params.message_spans.spans) {
+                        if (span.pos >= pos_after) {
+                            span.pos = (size_t) ((int64_t) span.pos + shift);
+                        }
+                    }
+
+                    SLT_INF(slot, "previous reply kept as generated: the prompt differs at %zu, %zu cached tokens stand for its %d re-rendered ones\n",
+                            n_past, cached.size() - n_past, n_same);
+
+                    task.tokens = server_tokens(merged, false);
+                }
+            }
+        }
+
         slot.task = std::make_unique<const server_task>(std::move(task));
 
