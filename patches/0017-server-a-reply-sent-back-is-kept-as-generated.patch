+// PS5LM: keep the previous reply as it was generated.
+//
+// A chat client sends the previous reply back as a message. The chat template writes that message out again and the
+// text is tokenised again, and the result is not always the tokens the model generated: the same text can be spelled
+// with other tokens (" book" + "marks" generated, " bookmarks" on the way back), and the whitespace around the end
+// of the reasoning is the template's, not the model's. The prompt cache then stops matching inside the reply. A model
+// with recurrent state cannot go back a few tokens, so the slot falls back to a context checkpoint and reads the
+// whole reply again - or, resumed from a parked save, the whole last firing.
+//
+// Tokens are compared as what they say: marker tokens (control and user-defined) by id and in order, and the bytes
+// of text between them. One place is excepted, because no client can send back what the model wrote there: the
+// end-of-reasoning marker that closes the thinking block the template opened in an assistant turn. The template
+// trims the reasoning and writes its own separator before that marker, and the reply parser drops the whitespace
+// after it while the template writes its own there too. So the whitespace right before that marker and the leading
+// whitespace of the text right after it are not compared. At any other end-of-reasoning marker - one the model
+// wrote into its answer, one in a user or a tool message - everything is compared.
+struct reply_shape {
+    const llama_vocab * vocab;
+    const common_chat_msg_delimiters * delims; // where turns start
+    const llama_tokens * think_start;          // the tag that opens the thinking block
+    const std::vector<llama_tokens> * think_ends;
+};
+
+struct reply_unit {
+    llama_token marker; // the marker this text follows, LLAMA_TOKEN_NULL for the first unit
+    std::string text;   // without the whitespace that is not compared
+    bool after_close;   // follows the marker that closes a template-opened thinking block
+    bool operator==(const reply_unit & o) const { return marker == o.marker && after_close == o.after_close && text == o.text; }
+};
+
+struct reply_place {    // where a token boundary is: a unit, before or after its dropped leading whitespace, a byte
+    size_t unit;
+    size_t phase;
+    size_t byte;
+    bool   valid;       // false inside whitespace that is not compared: never where two token lists are joined
+    bool operator<(const reply_place & o) const {
+        return unit != o.unit ? unit < o.unit : phase != o.phase ? phase < o.phase : byte < o.byte;
+    }
+    bool same(const reply_place & o) const { return unit == o.unit && phase == o.phase && byte == o.byte; }
+};
+
+static bool reply_is_space(const std::string & s, size_t from, size_t to) {
+    for (size_t i = from; i < to; i++) {
+        if (!std::isspace((unsigned char) s[i])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// the positions of the end-of-reasoning markers that close a thinking block the template opened in an assistant
+// turn: the first one after an assistant delimiter that is followed at once by the start tag, with no other turn
+// starting in between. "At once": nothing but whitespace between the delimiter and the tag. Ascending.
+static std::vector<size_t> reply_block_closers(const reply_shape & shape, const llama_tokens & toks) {
+    std::vector<size_t> closers;
+    if (shape.delims == nullptr || shape.think_start == nullptr || shape.think_start->empty()) {
+        return closers;
+    }
+    const auto is_end = [&](llama_token t) {
+        for (const auto & e : *shape.think_ends) {
+            if (e.size() == 1 && e[0] == t) {
+                return true;
+            }
+        }
+        return false;
+    };
+    const auto & start = *shape.think_start;
+    bool open = false;
+    for (size_t i = 0; i < toks.size(); i++) {
+        for (const auto & d : shape.delims->delimiters) {
+            if (d.tokens.empty() || i + d.tokens.size() > toks.size() || !std::equal(d.tokens.begin(), d.tokens.end(), toks.begin() + i)) {
+                continue;
+            }
+            // the delimiter is kept without the whitespace after it ("<|im_start|>assistant", then a newline)
+            size_t j = i + d.tokens.size();
+            while (j < toks.size() && toks[j] != LLAMA_TOKEN_NULL &&
+                   !(llama_vocab_get_attr(shape.vocab, toks[j]) & (LLAMA_TOKEN_ATTR_CONTROL | LLAMA_TOKEN_ATTR_USER_DEFINED))) {
+                const std::string piece = common_token_to_piece(shape.vocab, toks[j], false);
+                if (!reply_is_space(piece, 0, piece.size())) {
+                    break;
+                }
+                j++;
+            }
+            open = d.role == COMMON_CHAT_ROLE_ASSISTANT && j + start.size() <= toks.size() &&
+                   std::equal(start.begin(), start.end(), toks.begin() + j);
+            if (open) {
+                i = j + start.size() - 1; // the start tag itself is not looked at again
+            }
+            break;
+        }
+        if (open && is_end(toks[i])) {
+            closers.push_back(i);
+            open = false;
+        }
+    }
+    return closers;
+}
+
+// units: what toks[from..) say; after[k]: the boundary after token from + k
+static void reply_read(const reply_shape & shape, const llama_tokens & toks, size_t from,
+                       std::vector<reply_unit> & units, std::vector<reply_place> * after) {
+    const std::vector<size_t> closers = reply_block_closers(shape, toks);
+    auto closer = std::lower_bound(closers.begin(), closers.end(), from);
+
+    struct raw_unit {
+        llama_token marker;
+        std::string text;
+        bool lead;  // leading whitespace is not compared
+        bool trail; // trailing whitespace is not compared
+    };
+    std::vector<raw_unit> raw;
+    std::vector<std::pair<size_t, size_t>> ends; // per token: its unit and where it ends in the unit's text
+
+    // the first unit starts in the middle of things: its leading whitespace is the kind that is not compared when
+    // only whitespace lies between the closing marker before it and here
+    bool lead0 = false;
+    if (closer != closers.begin()) {
+        lead0 = true;
+        for (size_t i = *(closer - 1) + 1; i < from && lead0; i++) {
+            const llama_token t = toks[i];
+            if (t == LLAMA_TOKEN_NULL || (llama_vocab_get_attr(shape.vocab, t) & (LLAMA_TOKEN_ATTR_CONTROL | LLAMA_TOKEN_ATTR_USER_DEFINED))) {
+                lead0 = false;
+            } else {
+                const std::string piece = common_token_to_piece(shape.vocab, t, false);
+                lead0 = reply_is_space(piece, 0, piece.size());
+            }
+        }
+    }
+    raw.push_back({LLAMA_TOKEN_NULL, "", lead0, false});
+
+    for (size_t i = from; i < toks.size(); i++) {
+        const llama_token t = toks[i];
+        if (t == LLAMA_TOKEN_NULL) {
+            break; // a media chunk: nothing past it is compared
+        }
+        if (llama_vocab_get_attr(shape.vocab, t) & (LLAMA_TOKEN_ATTR_CONTROL | LLAMA_TOKEN_ATTR_USER_DEFINED)) {
+            const bool closes = closer != closers.end() && *closer == i;
+            if (closes) {
+                raw.back().trail = true;
+                ++closer;
+            }
+            raw.push_back({t, "", closes, false});
+        } else {
+            raw.back().text += common_token_to_piece(shape.vocab, t, false);
+        }
+        ends.emplace_back(raw.size() - 1, raw.back().text.size());
+    }
+
+    std::vector<size_t> n_lead(raw.size(), 0);
+    std::vector<size_t> n_text(raw.size(), 0);
+    for (size_t u = 0; u < raw.size(); u++) {
+        const std::string & text = raw[u].text;
+        size_t a = 0;
+        size_t b = text.size();
+        while (raw[u].lead && a < b && std::isspace((unsigned char) text[a])) {
+            a++;
+        }
+        while (raw[u].trail && b > a && std::isspace((unsigned char) text[b - 1])) {
+            b--;
+        }
+        n_lead[u] = a;
+        n_text[u] = b - a;
+        units.push_back({raw[u].marker, text.substr(a, b - a), raw[u].lead});
+    }
+
+    if (after == nullptr) {
+        return;
+    }
+    // Whitespace that is not compared is only ever passed whole and together with what it belongs to: a boundary
+    // inside it is not a place to join two token lists. Before the dropped leading whitespace of a unit is one
+    // place (phase 0: right after the marker), after it another (phase 1), so that a join never takes the
+    // whitespace of both sides or of neither.
+    for (const auto & e : ends) {
+        const size_t u = e.first;
+        const size_t r = e.second;
+        reply_place p = {u, 0, 0, true};
+        if (raw[u].lead) {
+            if (r == 0 && n_lead[u] > 0) {
+                p = {u, 0, 0, true};                       // the marker itself, whitespace follows
+            } else if (r < n_lead[u]) {
+                p = {u, 0, 0, false};                      // inside the leading whitespace
+            } else {
+                p = {u, 1, r - n_lead[u], true};
+            }
+        } else {
+            p = {u, 0, r, true};
+        }
+        if (r > n_lead[u] + n_text[u]) {
+            p = {u, p.phase, n_text[u], false};            // inside the trailing whitespace
+        }
+        after->push_back(p);
+    }
+}
+
+// cached[n_past..) is what the slot holds past the common prefix, next[n_past..) what the new prompt has there.
+// This finds how far the two go on saying the same: the furthest pair of token boundaries, one in each, up to
+// which they are the same units. Returns false when that is no further than n_past.
+//
+// The slot's tokens up to n_cached then stand for the prompt's up to n_next. It need not be the whole of either:
+// a later message that was really changed, a reply that was cut off or cancelled, and every request after a reply
+// was kept (each renders that reply again) all stop somewhere, and the rest is the usual path's.
+// pa and pb are the boundaries after each token of the two, from n_past on.
+static bool reply_as_generated(const reply_shape & shape, const llama_tokens & cached, const llama_tokens & next, size_t n_past,
+                               size_t & n_cached, size_t & n_next, std::vector<reply_place> & pa, std::vector<reply_place> & pb) {
+    std::vector<reply_unit> ua;
+    std::vector<reply_unit> ub;
+    reply_read(shape, cached, n_past, ua, &pa);
+    reply_read(shape, next,   n_past, ub, &pb);
+
+    // how far the two say the same
+    reply_place limit = {0, 0, 0, true};
+    for (size_t u = 0; u < ua.size() && u < ub.size(); u++) {
+        if (ua[u].after_close != ub[u].after_close || (u > 0 && ua[u].marker != ub[u].marker)) {
+            break;
+        }
+        const std::string & ta = ua[u].text;
+        const std::string & tb = ub[u].text;
+        size_t n = 0;
+        while (n < ta.size() && n < tb.size() && ta[n] == tb[n]) {
+            n++;
+        }
+        limit = {u, (size_t) (ua[u].after_close ? 1 : 0), n, true};
+        if (n < ta.size() || n < tb.size()) {
+            break;
+        }
+    }
+
+    // the furthest boundary both have within that
+    size_t ia = pa.size();
+    size_t ib = pb.size();
+    while (ia > 0 && ib > 0) {
+        const reply_place & a = pa[ia - 1];
+        const reply_place & b = pb[ib - 1];
+        if (!a.valid || limit < a) {
+            ia--;
+        } else if (!b.valid || limit < b) {
+            ib--;
+        } else if (a.same(b)) {
+            break;
+        } else if (b < a) {
+            ia--;
+        } else {
+            ib--;
+        }
+    }
+    if (ia == 0 || ib == 0) {
+        return false;
+    }
+    n_cached = n_past + ia;
+    n_next   = n_past + ib;
+    return true;
+}
+
+// whether two token lists say the same from a token on
+static bool reply_says_the_same(const reply_shape & shape, const llama_tokens & a, const llama_tokens & b, size_t from) {
+    static const bool test_reject = getenv("LLAMA_REPLY_AS_GENERATED_TEST_REJECT") != nullptr; // for the test of the caller's fallback
+    std::vector<reply_unit> ua;
+    std::vector<reply_unit> ub;
+    reply_read(shape, a, from, ua, nullptr);
+    reply_read(shape, b, from, ub, nullptr);
+    return ua == ub && !test_reject;
+}
+
+// on only when LLAMA_REPLY_AS_GENERATED is 1, true, on or yes (the fleet controller sets it for its hosts); off otherwise
+static bool reply_as_generated_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("LLAMA_REPLY_AS_GENERATED");
+        std::string v = e != nullptr ? e : "";
+        std::transform(v.begin(), v.end(), v.begin(), [](unsigned char c) { return (char) std::tolower(c); });
+        return v == "1" || v == "true" || v == "on" || v == "yes";
+    }();
+    return enabled;
+}
