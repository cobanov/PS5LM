+// PS5LM: keep the previous reply as it was generated.
+//
+// A chat client sends the previous reply back as a message. The chat template writes that message out again and the
+// text is tokenised again, and the result is not always the tokens the model generated: the same text can be spelled
+// with other tokens (" book" + "marks" generated, " bookmarks" on the way back), and the template trims the reasoning,
+// so whitespace the model wrote just before the end-of-reasoning marker is gone. The prompt cache then stops matching
+// inside the reply. A model with recurrent state cannot go back a few tokens, so the slot falls back to a context
+// checkpoint and reads the whole reply again - or, resumed from a parked save, the whole last firing.
+//
+// cached[n_past..) is what the slot holds past the common prefix, next[n_past..) what the new prompt has there.
+// The slot's tokens end inside a turn (its end-of-turn token was sampled, not evaluated), so the part of the new
+// prompt they can stand for ends right before an end-of-turn token: the one after as many complete turns as the
+// cached tail holds. (More than one turn once an earlier reply was kept: every later prompt renders it again.)
+// When cached[n_past..) and next[n_past..end) say the same, this returns end - n_past, the number of new-prompt
+// tokens the cached tokens stand for; otherwise -1.
+// "The same" means: the same marker tokens (control and user-defined tokens, compared by id) in the same order,
+// and between them the same bytes of text, except that whitespace right before an end-of-reasoning marker is not
+// compared (the template drops it, so no client can send it back).
+static int32_t reply_as_generated(const llama_vocab * vocab, const llama_tokens & cached, const llama_tokens & next,
+                                  size_t n_past, const std::vector<llama_tokens> & reasoning_ends) {
+    if (n_past >= cached.size()) {
+        return -1;
+    }
+    const auto is_eog = [&](llama_token t) { return t != LLAMA_TOKEN_NULL && llama_vocab_is_eog(vocab, t); };
+
+    size_t n_turns = 0;
+    for (size_t i = n_past; i < cached.size(); i++) {
+        n_turns += is_eog(cached[i]) ? 1 : 0;
+    }
+    size_t end = n_past;
+    for (; end < next.size(); end++) {
+        if (is_eog(next[end]) && n_turns-- == 0) {
+            break;
+        }
+    }
+    if (end >= next.size()) {
+        return -1;
+    }
+
+    struct unit {
+        llama_token marker; // the marker this text follows, LLAMA_TOKEN_NULL for the first unit
+        std::string text;
+        bool operator==(const unit & o) const { return marker == o.marker && text == o.text; }
+    };
+
+    const auto split = [&](const llama_tokens & toks, size_t from, size_t to, std::vector<unit> & out) {
+        out.push_back({LLAMA_TOKEN_NULL, ""});
+        for (size_t i = from; i < to; i++) {
+            const llama_token t = toks[i];
+            if (t == LLAMA_TOKEN_NULL) {
+                return false; // a media chunk
+            }
+            if (llama_vocab_get_attr(vocab, t) & (LLAMA_TOKEN_ATTR_CONTROL | LLAMA_TOKEN_ATTR_USER_DEFINED)) {
+                for (const auto & e : reasoning_ends) {
+                    if (e.size() == 1 && e[0] == t) {
+                        auto & text = out.back().text;
+                        while (!text.empty() && std::isspace((unsigned char) text.back())) {
+                            text.pop_back();
+                        }
+                    }
+                }
+                out.push_back({t, ""});
+            } else {
+                out.back().text += common_token_to_piece(vocab, t, false);
+            }
+        }
+        return true;
+    };
+
+    std::vector<unit> a;
+    std::vector<unit> b;
+    if (!split(cached, n_past, cached.size(), a) || !split(next, n_past, end, b) || !(a == b)) {
+        return -1;
+    }
+    return (int32_t) (end - n_past);
+}
+
+// LLAMA_REPLY_AS_GENERATED=0 turns it off (to compare)
+static bool reply_as_generated_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("LLAMA_REPLY_AS_GENERATED");
+        return !(e != nullptr && e[0] == '0');
+    }();
+    return enabled;
+}
+
 // a checkpoint restore dropped tokens the target had accepted - re-accept them rather than verify again
 static std::vector<llama_token> server_accept_replay(
         common_sampler * smpl,
