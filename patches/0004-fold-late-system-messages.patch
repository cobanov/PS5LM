+                }
+            } else {
+                json front = json::array();
+                front.push_back({ { "role", "system" }, { "content", extra.substr(2) } });
+                for (auto & m : kept) {
+                    front.push_back(std::move(m));
+                }
+                kept = std::move(front);
+            }
+        }
+        messages = std::move(kept);
+    }
